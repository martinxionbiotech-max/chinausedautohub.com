---
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { CONTACT } from '../../lib/site';

const title = 'Contact — China Used Car Export';
const description = 'Contact China Used Car Export by email or WhatsApp to enquire about a vehicle or request a quote.';
---

<BaseLayout title={title} description={description} canonical="/contact/">
  <Breadcrumb crumbs={[{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact/' }]} />

  <section class="container-site py-6">
    <h1 class="text-3xl font-bold text-ink">Contact</h1>
    <p class="mt-2 max-w-2xl text-ink-soft">Get in touch to enquire about a vehicle or request a quote.</p>

    <div class="mt-8 grid gap-5 max-w-3xl sm:grid-cols-2">
      <a href={`mailto:${CONTACT.email}`} class="card p-6 hover:border-brand-300">
        <h2 class="text-base font-semibold text-ink">Email</h2>
        <p class="mt-2 text-sm text-ink-soft">For vehicle enquiries and quotes.</p>
        <p class="mt-3 text-sm font-semibold text-brand-700">{CONTACT.email}</p>
      </a>
      <a href={CONTACT.whatsappLink} target="_blank" rel="noopener noreferrer" class="card p-6 hover:border-brand-300">
        <h2 class="text-base font-semibold text-ink">WhatsApp</h2>
        <p class="mt-2 text-sm text-ink-soft">For quick questions and sourcing requests.</p>
        <p class="mt-3 text-sm font-semibold text-brand-700">{CONTACT.whatsapp}</p>
      </a>
    </div>

    <div class="mt-8 max-w-3xl">
      <p class="text-sm text-ink-soft">
        Prefer to describe what you're looking for? Use the{' '}
        <a href="/request-a-car/" class="font-semibold text-brand-700 hover:underline">Request a Car</a> form and we will
        get back to you by email or WhatsApp.
      </p>
    </div>
  </section>
</BaseLayout>
