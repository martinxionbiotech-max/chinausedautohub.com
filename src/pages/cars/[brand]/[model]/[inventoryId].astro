---
import BaseLayout from '../../../../components/BaseLayout.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import VehicleCard from '../../../../components/VehicleCard.astro';
import LeadForm from '../../../../components/LeadForm.astro';
import { getAllVehicles, getVehicle, getSimilarVehicles, resolveVehicle, vehicleTitle } from '../../../../lib/data';
import { formatPrice, formatMileage, formatDate, SITE } from '../../../../lib/site';
import { brandUrl, dataModelUrl, dataBrandUrl, vehicleUrl } from '../../../../lib/urls';
import { vehicleSchema, breadcrumbSchema, faqSchema, type FaqItem } from '../../../../lib/schema';
import type { Vehicle } from '../../../../lib/types';

export function getStaticPaths() {
  const vehicles = getAllVehicles();
  return vehicles.map((v) => ({
    params: { brand: v.brand, model: v.model, inventoryId: v.vehicle_id },
    props: { vehicle: v },
  }));
}

const { vehicle } = Astro.props as { vehicle: Vehicle };
const d = resolveVehicle(vehicle);
const title = vehicleTitle(d);
const isSold = vehicle.status === 'sold';
const isReserved = vehicle.status === 'reserved';

const similar = getSimilarVehicles(vehicle, 4);

const statusLabel = {
  available: 'Available',
  reserved: 'Reserved',
  sold: 'Sold',
  unavailable: 'Unavailable',
}[vehicle.status];

const pageTitle = `${title} — ${formatPrice(vehicle.price)} | China Used Car Export`;
const description = `${vehicle.year} ${d.brand?.name} ${d.model?.name}, ${formatMileage(vehicle.mileage_km)}, ${vehicle.fuel.toUpperCase()}, ${vehicle.color}, ${vehicle.location}. ${vehicle.status === 'available' ? 'Available for export' : `Status: ${vehicle.status}`}.`;

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Cars', path: '/cars/' },
  { name: d.brand?.name ?? vehicle.brand, path: brandUrl({ slug: vehicle.brand }) },
  { name: title, path: vehicleUrl(vehicle) },
];

const faqs: FaqItem[] = [];
if (isSold) {
  faqs.push({ question: 'Is this vehicle still available?', answer: 'No — this vehicle has been sold. It is retained on the site for reference. Browse similar available vehicles below or request a car.' });
} else {
  faqs.push({ question: 'Is this vehicle available?', answer: `Yes — its current status is ${statusLabel.toLowerCase()}. Contact us to confirm availability and receive a quote.` });
}
faqs.push({ question: 'Can this vehicle be exported from China?', answer: 'Yes. We can help arrange export preparation and shipping for your destination. Final landed cost depends on shipping, taxes, import duties and destination.' });
faqs.push({ question: 'What does the listed price include?', answer: 'The listed price is the asking price for the vehicle. It may vary based on configuration, shipping, taxes and destination, and does not include landed costs.' });
if (vehicle.is_demo) {
  faqs.push({ question: 'Is this a real listing?', answer: 'No — this is DEMO DATA used to demonstrate the platform and is not a real vehicle for sale. Specifications and price are illustrative.' });
}

const schemas = [vehicleSchema(vehicle), breadcrumbSchema(crumbs)];
if (faqs.length > 0) schemas.push(faqSchema(faqs));
---

<BaseLayout title={pageTitle} description={description} canonical={vehicleUrl(vehicle)} schema={schemas}>
  <Breadcrumb crumbs={crumbs} />

  <section class="container-site pb-6">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <h1 class="text-2xl font-bold text-ink sm:text-3xl">{title}</h1>
      <div class="flex items-center gap-2">
        {vehicle.is_demo && (
          <span class="rounded border border-surface-line bg-surface-alt px-2.5 py-1 text-xs font-semibold text-ink-muted">DEMO DATA</span>
        )}
        <span class:list={[
          'rounded border px-2.5 py-1 text-xs font-semibold',
          isSold ? 'bg-red-50 text-red-700 border-red-200'
          : isReserved ? 'bg-amber-50 text-amber-700 border-amber-200'
          : 'bg-green-50 text-green-700 border-green-200',
        ]}>
          {statusLabel}
        </span>
      </div>
    </div>
    <p class="mt-1 text-sm text-ink-muted">Vehicle ID: {vehicle.vehicle_id} · Last updated {formatDate(vehicle.updated_at)}</p>
  </section>

  {isSold && (
    <div class="container-site pb-8">
      <div class="rounded-lg border border-red-200 bg-red-50 p-4">
        <p class="text-base font-semibold text-red-800">This vehicle has been sold.</p>
        <p class="mt-1 text-sm text-red-700">The listing is retained for reference. See similar available vehicles below, or request a car and we can source a comparable unit.</p>
      </div>
    </div>
  )}

  <section class="container-site grid gap-8 lg:grid-cols-[1.4fr_1fr]">
    <!-- GALLERY -->
    <div>
      <div class="card overflow-hidden">
        <img
          src={vehicle.images[0]}
          alt={`${title} — demo placeholder image`}
          width="1200"
          height="800"
          fetchpriority="high"
          decoding="async"
          class="w-full object-cover"
        />
      </div>
      {vehicle.is_demo && (
        <p class="mt-2 text-xs text-ink-muted">
          Demo placeholder image — no real vehicle photo is available for this listing.
        </p>
      )}
    </div>

    <!-- SUMMARY -->
    <aside class="card h-fit p-5">
      <h2 class="sr-only">Vehicle summary</h2>
      <dl class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
        <div><dt class="text-ink-muted">Year</dt><dd class="font-medium text-ink">{vehicle.year}</dd></div>
        <div><dt class="text-ink-muted">Mileage</dt><dd class="font-medium text-ink">{formatMileage(vehicle.mileage_km)}</dd></div>
        <div><dt class="text-ink-muted">Fuel</dt><dd class="font-medium text-ink">{d.fuelType?.name ?? vehicle.fuel}</dd></div>
        <div><dt class="text-ink-muted">Transmission</dt><dd class="font-medium text-ink">{d.transmission?.name ?? vehicle.transmission}</dd></div>
        <div><dt class="text-ink-muted">Drive</dt><dd class="font-medium text-ink">{d.drive?.name ?? vehicle.drive}</dd></div>
        <div><dt class="text-ink-muted">Color</dt><dd class="font-medium text-ink">{vehicle.color}</dd></div>
        <div><dt class="text-ink-muted">Location</dt><dd class="font-medium text-ink">{vehicle.location}</dd></div>
        <div><dt class="text-ink-muted">Status</dt><dd class="font-medium text-ink">{statusLabel}</dd></div>
      </dl>

      <div class="mt-5 border-t border-surface-line pt-4">
        <p class="text-sm text-ink-muted">Asking price</p>
        <p class="mt-1 text-2xl font-bold text-ink">{formatPrice(vehicle.price)}</p>
        {vehicle.original_price && (
          <p class="mt-1 text-xs text-ink-muted">Original listing: {formatPrice(vehicle.original_price)}</p>
        )}
        {vehicle.is_demo && <p class="mt-1 text-xs text-ink-muted">Example price — demo listing</p>}
        <p class="mt-2 text-xs text-ink-muted">Price may vary based on configuration, shipping, taxes and destination.</p>
      </div>

      <div class="mt-4 grid gap-2">
        {!isSold ? (
          <a href="#lead-form" class="btn-primary w-full">Request Quote</a>
        ) : (
          <a href="/request-a-car/" class="btn-primary w-full">Request Similar Vehicle</a>
        )}
        <a href="/request-a-car/" class="btn-secondary w-full">Request Similar Vehicle</a>
      </div>
    </aside>
  </section>

  <!-- KEY SPECS -->
  <section class="container-site mt-10">
    <h2 class="text-xl font-bold text-ink">Key Specifications</h2>
    <div class="mt-4 grid gap-px overflow-hidden rounded-lg border border-surface-line bg-surface-line sm:grid-cols-2 lg:grid-cols-3">
      {vehicle.specs.map((s) => (
        <div class="bg-white p-4">
          <dt class="text-sm text-ink-muted">{s.label}</dt>
          <dd class="mt-0.5 text-sm font-medium text-ink">{s.value}</dd>
        </div>
      ))}
      <div class="bg-white p-4">
        <dt class="text-sm text-ink-muted">Body type</dt>
        <dd class="mt-0.5 text-sm font-medium text-ink">{d.bodyType?.name ?? vehicle.body_type}</dd>
      </div>
    </div>
  </section>

  <!-- DESCRIPTION -->
  <section class="container-site mt-10">
    <h2 class="text-xl font-bold text-ink">Description</h2>
    <p class="prose-vehicle mt-3 max-w-3xl">{vehicle.description}</p>
  </section>

  <!-- CONDITION -->
  <section class="container-site mt-10">
    <h2 class="text-xl font-bold text-ink">Condition</h2>
    <div class="mt-4 grid gap-px overflow-hidden rounded-lg border border-surface-line bg-surface-line sm:grid-cols-2 lg:grid-cols-3">
      {Object.entries(vehicle.condition).map(([k, v]) => (
        <div class="bg-white p-4">
          <dt class="text-sm text-ink-muted capitalize">{k.replaceAll('_', ' ')}</dt>
          <dd class="mt-0.5 text-sm font-medium text-ink">{v}</dd>
        </div>
      ))}
    </div>
  </section>

  <!-- EXPORT INFORMATION (only when real data exists) -->
  {vehicle.export && (
    <section class="container-site mt-10">
      <h2 class="text-xl font-bold text-ink">Export Information</h2>
      <div class="mt-4 grid gap-px overflow-hidden rounded-lg border border-surface-line bg-surface-line sm:grid-cols-2">
        {Object.entries(vehicle.export).map(([k, v]) => (
          <div class="bg-white p-4">
            <dt class="text-sm text-ink-muted capitalize">{k.replaceAll('_', ' ')}</dt>
            <dd class="mt-0.5 text-sm font-medium text-ink">{v}</dd>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- MODEL INFORMATION -->
  <section class="container-site mt-10">
    <div class="card p-5">
      <h2 class="text-lg font-bold text-ink">About the {d.model?.name} model</h2>
      <p class="mt-2 text-sm text-ink-soft max-w-3xl">{d.model?.shortDescription ?? 'Vehicle model information.'}</p>
      <div class="mt-3 flex flex-wrap gap-4 text-sm">
        <a href={dataModelUrl({ brand: vehicle.brand, slug: vehicle.model })} target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-700 hover:underline">
          View detailed {d.model?.name} specifications →
        </a>
        <a href={dataBrandUrl({ slug: vehicle.brand })} target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-700 hover:underline">
          {d.brand?.name} brand data →
        </a>
      </div>
    </div>
  </section>

  <!-- REQUEST QUOTE -->
  <section class="container-site mt-10" id="quote">
    <LeadForm variant="quote" vehicle={vehicle} />
  </section>

  <!-- SIMILAR -->
  {similar.length > 0 && (
    <section class="container-site mt-12">
      <h2 class="text-xl font-bold text-ink">Similar Vehicles</h2>
      <div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {similar.map((v) => <VehicleCard vehicle={v} />)}
      </div>
    </section>
  )}

  <!-- FAQ -->
  {faqs.length > 0 && (
    <section class="container-site mt-12 max-w-3xl">
      <h2 class="text-xl font-bold text-ink">Frequently Asked Questions</h2>
      <div class="mt-4 space-y-3">
        {faqs.map((f) => (
          <details class="card p-4">
            <summary class="cursor-pointer text-sm font-semibold text-ink">{f.question}</summary>
            <p class="mt-2 text-sm text-ink-soft">{f.answer}</p>
          </details>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
