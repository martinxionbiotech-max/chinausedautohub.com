---
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LeadForm from '../../components/LeadForm.astro';
import { SITE } from '../../lib/site';

const title = 'Request a Used Car from China';
const description = "Can't find the vehicle you're looking for? Tell us your requirements and we can help source it from China's vehicle market.";
---

<BaseLayout title={title} description={description} canonical="/request-a-car/">
  <Breadcrumb crumbs={[{ name: 'Home', path: '/' }, { name: 'Request a Car', path: '/request-a-car/' }]} />

  <section class="container-site py-6">
    <h1 class="text-3xl font-bold text-ink">Request a Used Car from China</h1>
    <p class="mt-2 max-w-2xl text-ink-soft">
      Can't find the vehicle you're looking for? Tell us your requirements and we can help source it from China's vehicle market.
    </p>
    <p class="mt-2 max-w-2xl text-sm text-ink-muted">
      You don't need to know the exact model — tell us the type, year, budget and destination, and we will source options for you.
    </p>
  </section>

  <section class="container-site pb-10">
    <div class="max-w-3xl">
      <LeadForm variant="full" />
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // Prefill destination from ?country= (e.g. hero search → request a car).
  const params = new URLSearchParams(location.search);
  const country = params.get('country');
  if (country) {
    const el = document.getElementById('request-car-form-country');
    if (el) el.value = country;
  }
</script>
