---
import BaseLayout from '../components/BaseLayout.astro';

const title = 'Page not found — China Used Car Export';
const description = 'The page you are looking for could not be found.';
---

<BaseLayout title={title} description={description} noindex>
  <section class="container-site flex min-h-[50vh] flex-col items-center justify-center py-24 text-center">
    <p class="text-5xl font-bold text-brand-800">404</p>
    <h1 class="mt-3 text-2xl font-bold text-ink">Page not found</h1>
    <p class="mt-2 text-ink-soft">The page you are looking for could not be found.</p>
    <div class="mt-6 flex gap-3">
      <a href="/" class="btn-primary">Go home</a>
      <a href="/cars/" class="btn-secondary">Browse cars</a>
    </div>
  </section>
</BaseLayout>
