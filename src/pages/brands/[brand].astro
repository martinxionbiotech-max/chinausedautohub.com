---
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import VehicleCard from '../../components/VehicleCard.astro';
import {
  getBrand,
  getVehiclesByBrand,
  getPopularModelsForBrand,
  getBodyType,
  getBrandsWithVehicles,
} from '../../lib/data';
import { SITE } from '../../lib/site';
import { dataBrandUrl, dataModelUrl, brandUrl } from '../../lib/urls';
import { itemListSchema } from '../../lib/schema';
import type { Vehicle } from '../../lib/types';

export function getStaticPaths() {
  // Only brands that actually have vehicles get a page.
  return getBrandsWithVehicles().map((b) => ({ params: { brand: b.slug } }));
}

const { brand: brandSlug } = Astro.params;
const brand = getBrand(brandSlug);

if (!brand) {
  return Astro.redirect('/brands/');
}

const vehicles = getVehiclesByBrand(brandSlug);
const available = vehicles.filter((v) => v.status === 'available');
const popularModels = getPopularModelsForBrand(brandSlug);

// Body types represented in this brand's inventory.
const typeSlugs = Array.from(new Set(vehicles.map((v) => v.body_type)));
const vehicleTypes = typeSlugs.map((s) => getBodyType(s)).filter(Boolean);

const markets = [
  { slug: 'uae', name: 'UAE' },
  { slug: 'saudi-arabia', name: 'Saudi Arabia' },
  { slug: 'kenya', name: 'Kenya' },
  { slug: 'nigeria', name: 'Nigeria' },
];

const title = `${brand.name} Used Cars for Export from China`;
const description = `Browse ${available.length} available ${brand.name} vehicles for export from China — models, specifications and pricing.`;

const schema = itemListSchema(available.map((v) => ({ name: `${v.year} ${brand.name} ${v.model}`, url: `/cars/${v.brand}/${v.model}/${v.vehicle_id}/` })));
---

<BaseLayout title={title} description={description} canonical={brandUrl(brand)} schema={schema}>
  <Breadcrumb crumbs={[{ name: 'Home', path: '/' }, { name: 'Brands', path: '/brands/' }, { name: brand.name, path: brandUrl(brand) }]} />

  <section class="container-site py-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-ink">{brand.name} Vehicles for Export</h1>
        <p class="mt-2 max-w-3xl text-ink-soft">{brand.overview}</p>
      </div>
      <a href="/request-a-car/" class="btn-primary">Request a {brand.name}</a>
    </div>
  </section>

  <section class="container-site">
    <h2 class="text-xl font-bold text-ink">Available Vehicles</h2>
    {available.length > 0 ? (
      <div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {available.map((v: Vehicle) => <VehicleCard vehicle={v} />)}
      </div>
    ) : (
      <p class="mt-3 text-ink-soft">No {brand.name} vehicles are currently available. <a href="/request-a-car/" class="font-semibold text-brand-700">Request a {brand.name}</a> and we can source one for you.</p>
    )}
  </section>

  {popularModels.length > 0 && (
    <section class="container-site mt-12">
      <h2 class="text-xl font-bold text-ink">Popular Models</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {popularModels.map((m) => (
          <a href={dataModelUrl(m)} target="_blank" rel="noopener noreferrer" class="card p-4 hover:border-brand-300">
            <span class="block text-base font-semibold text-ink">{m.name}</span>
            <span class="block text-sm text-ink-muted">{m.shortDescription}</span>
            <span class="mt-2 block text-sm font-semibold text-brand-700">View specifications →</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {vehicleTypes.length > 0 && (
    <section class="container-site mt-12">
      <h2 class="text-xl font-bold text-ink">Vehicle Types</h2>
      <div class="mt-4 flex flex-wrap gap-3">
        {vehicleTypes.map((t) => (
          <a href={`/body-types/${t.slug}/`} class="card px-4 py-2.5 text-sm font-medium text-ink hover:border-brand-300">{t.name}</a>
        ))}
      </div>
    </section>
  )}

  <section class="container-site mt-12">
    <div class="grid gap-5 lg:grid-cols-2">
      <a href={dataBrandUrl(brand)} target="_blank" rel="noopener noreferrer" class="card p-5 hover:border-brand-300">
        <h2 class="text-lg font-semibold text-ink">{brand.name} Data</h2>
        <p class="mt-2 text-sm text-ink-soft">Full brand profile and model data live on the future Data sub-site.</p>
        <span class="mt-2 block text-sm font-semibold text-brand-700">data.chinausedautohub.com →</span>
      </a>
      <div class="card p-5">
        <h2 class="text-lg font-semibold text-ink">Related Markets</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {markets.map((m) => (
            <a href={`${SITE.subdomains.market}/${m.slug}`} target="_blank" rel="noopener noreferrer" class="rounded-md border border-surface-line px-3 py-1.5 text-sm text-ink hover:border-brand-300">{m.name}</a>
          ))}
        </div>
        <p class="mt-3 text-xs text-ink-muted">Market pages are part of a future Market sub-site.</p>
      </div>
    </div>
  </section>
</BaseLayout>
