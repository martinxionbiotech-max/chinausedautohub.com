---
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getBrandsWithVehicles, getVehiclesByBrand } from '../../lib/data';
import { brandUrl } from '../../lib/urls';
import { itemListSchema } from '../../lib/schema';

const brands = getBrandsWithVehicles();
const title = 'Car Brands Available for Export from China';
const description = 'Browse used vehicles for export from China by brand — BYD, Geely, Chery, Changan and more.';

const schema = itemListSchema(brands.map((b) => ({ name: b.name, url: brandUrl(b) })));
---

<BaseLayout title={title} description={description} canonical="/brands/" schema={schema}>
  <Breadcrumb crumbs={[{ name: 'Home', path: '/' }, { name: 'Brands', path: '/brands/' }]} />

  <section class="container-site py-6">
    <h1 class="text-3xl font-bold text-ink">Browse by Brand</h1>
    <p class="mt-2 max-w-2xl text-ink-soft">
      Explore vehicles by manufacturer. Only brands with vehicles currently in our inventory are listed.
    </p>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {brands.map((b) => {
        const count = getVehiclesByBrand(b.slug).length;
        return (
          <a href={brandUrl(b)} class="card p-5 hover:border-brand-300">
            <span class="flex h-11 w-11 items-center justify-center rounded bg-brand-800 text-sm font-bold text-white">{b.name.slice(0, 2).toUpperCase()}</span>
            <h2 class="mt-3 text-base font-semibold text-ink">{b.name}</h2>
            <p class="mt-1 text-sm text-ink-muted">{count} vehicle{count === 1 ? '' : 's'} available</p>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>
