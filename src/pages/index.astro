---
import BaseLayout from '../components/BaseLayout.astro';
import SearchModule from '../components/SearchModule.astro';
import VehicleCard from '../components/VehicleCard.astro';
import LeadForm from '../components/LeadForm.astro';
import {
  getFeaturedVehicles,
  getNewArrivals,
  getBrandsWithVehicles,
  getBodyTypesWithVehicles,
} from '../lib/data';
import { formatPrice, formatDate, SITE } from '../lib/site';
import { brandUrl, bodyTypeUrl, newArrivalsUrl, vehicleUrl } from '../lib/urls';
import { organizationSchema, webSiteSchema, itemListSchema } from '../lib/schema';
import type { Vehicle } from '../lib/types';

const featured = getFeaturedVehicles(8);
const arrivals = getNewArrivals(5);
const brands = getBrandsWithVehicles();
const bodyTypes = getBodyTypesWithVehicles();

const title = 'China Used Cars for Export — Source Quality Used Vehicles from China';
const description = SITE.description;

const trustItems = [
  { title: 'Wide Vehicle Selection', text: 'Browse sedans, SUVs and electrified vehicles sourced from China\u2019s domestic market.' },
  { title: 'China Market Sourcing', text: 'Vehicles sourced directly from China\u2019s domestic market for export buyers.' },
  { title: 'Export Support', text: 'We help coordinate export preparation and shipping for your destination.' },
  { title: 'Vehicle Information', text: 'Clear specifications, mileage and pricing on every listing.' },
];

const whyItems = [
  { title: 'Vehicle Selection', text: 'China\u2019s domestic market offers a broad range of petrol, hybrid and electric models to source from.' },
  { title: 'Competitive Sourcing', text: 'Direct sourcing from the domestic market can offer cost advantages on certain models and volumes.' },
  { title: 'EV & Hybrid Availability', text: 'Chinese brands produce a wide range of EVs and PHEVs that are increasingly exported worldwide.' },
  { title: 'Export-oriented Sourcing', text: 'Vehicles can be sourced and prepared with the export documentation your market requires.' },
];

const steps = [
  { n: '1', title: 'Find a Vehicle', text: 'Browse our available inventory or search by brand, model, year and price.' },
  { n: '2', title: 'Request a Quote', text: 'Send us the vehicle or your requirements and receive a quote.' },
  { n: '3', title: 'Confirm Vehicle & Shipping', text: 'Confirm the vehicle, configuration and shipping arrangement for your destination.' },
  { n: '4', title: 'Export from China', text: 'We coordinate export preparation and documentation for shipment.' },
];

const markets = [
  { slug: 'uae', name: 'UAE' },
  { slug: 'saudi-arabia', name: 'Saudi Arabia' },
  { slug: 'kenya', name: 'Kenya' },
  { slug: 'tanzania', name: 'Tanzania' },
  { slug: 'nigeria', name: 'Nigeria' },
  { slug: 'kazakhstan', name: 'Kazakhstan' },
  { slug: 'uzbekistan', name: 'Uzbekistan' },
];

const featuredListSchema = itemListSchema(
  featured.map((v) => ({ name: `${v.year} ${v.brand} ${v.model}`, url: vehicleUrl(v) })),
);
---

<BaseLayout title={title} description={description} schema={[organizationSchema(), webSiteSchema(), featuredListSchema]}>
  <!-- HERO -->
  <section class="bg-brand-900 text-white">
    <div class="container-site py-16 sm:py-20">
      <div class="max-w-2xl">
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">China Used Cars for Export</h1>
        <p class="mt-4 text-lg text-brand-100">Source quality used vehicles from China for your market.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/cars/" class="btn-primary">Browse Cars</a>
          <a href="/request-a-car/" class="btn-secondary !border-white/30 !bg-transparent !text-white hover:!bg-white/10">Request a Car</a>
        </div>
      </div>
      <div class="mt-10 rounded-lg bg-brand-800/60 p-5 sm:p-6">
        <SearchModule />
      </div>
    </div>
  </section>

  <!-- TRUST STRIP -->
  <section class="border-b border-surface-line bg-surface-alt">
    <div class="container-site grid gap-6 py-8 sm:grid-cols-2 lg:grid-cols-4">
      {trustItems.map((t) => (
        <div class="flex gap-3">
          <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded bg-brand-100 text-brand-800">
            <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 2l7 4v6c0 3.2-2.9 5.6-7 7-4.1-1.4-7-3.8-7-7V6l7-4z"/></svg>
          </span>
          <div>
            <h2 class="text-sm font-semibold text-ink">{t.title}</h2>
            <p class="mt-1 text-sm text-ink-soft">{t.text}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- FEATURED VEHICLES -->
  <section class="container-site py-14">
    <div class="flex items-end justify-between gap-4">
      <div>
        <h2 class="text-2xl font-bold text-ink">Featured Vehicles</h2>
        <p class="mt-1 text-ink-soft">A selection of currently available vehicles sourced from China.</p>
      </div>
      <a href="/cars/" class="btn-ghost hidden sm:inline-flex">View all vehicles →</a>
    </div>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {featured.map((v: Vehicle) => <VehicleCard vehicle={v} />)}
    </div>
    <a href="/cars/" class="btn-secondary mt-6 sm:hidden">View all vehicles →</a>
  </section>

  <!-- BROWSE BY BRAND -->
  <section class="bg-surface-alt py-14">
    <div class="container-site">
      <h2 class="text-2xl font-bold text-ink">Browse by Brand</h2>
      <p class="mt-1 text-ink-soft">Explore vehicles from brands currently in our inventory.</p>
      <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {brands.map((b) => (
          <a href={brandUrl(b)} class="card flex items-center gap-3 p-4 hover:border-brand-300">
            <span class="flex h-10 w-10 items-center justify-center rounded bg-brand-800 text-sm font-bold text-white">{b.name.slice(0, 2).toUpperCase()}</span>
            <div>
              <span class="block text-sm font-semibold text-ink">{b.name}</span>
              <span class="block text-xs text-ink-muted">Browse vehicles</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- BROWSE BY VEHICLE TYPE -->
  <section class="container-site py-14">
    <h2 class="text-2xl font-bold text-ink">Browse by Vehicle Type</h2>
    <p class="mt-1 text-ink-soft">Find vehicles by body type.</p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {bodyTypes.map((t) => (
        <a href={bodyTypeUrl(t)} class="card flex items-center justify-between p-5 hover:border-brand-300">
          <div>
            <span class="block text-base font-semibold text-ink">{t.name}</span>
            <span class="block text-sm text-ink-muted">{t.description}</span>
          </div>
          <span class="text-brand-700">→</span>
        </a>
      ))}
    </div>
  </section>

  <!-- NEW ARRIVALS -->
  <section class="bg-surface-alt py-14">
    <div class="container-site">
      <div class="flex items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl font-bold text-ink">New Arrivals</h2>
          <p class="mt-1 text-ink-soft">Recently added or updated vehicles.</p>
        </div>
        <a href={newArrivalsUrl()} class="btn-ghost hidden sm:inline-flex">All new arrivals →</a>
      </div>
      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
        {arrivals.map((v: Vehicle) => (
          <a href={vehicleUrl(v)} class="card flex gap-3 p-3 hover:border-brand-300">
            <img src={v.images[0]} alt="" loading="lazy" width="72" height="54" class="h-14 w-20 shrink-0 rounded object-cover" />
            <div class="min-w-0">
              <span class="block truncate text-sm font-semibold text-ink">{v.year} {v.brand} {v.model}</span>
              <span class="block text-sm font-bold text-brand-800">{formatPrice(v.price)}</span>
              <span class="block text-xs text-ink-muted">Updated {formatDate(v.updated_at)}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY SOURCE FROM CHINA -->
  <section class="container-site py-14">
    <h2 class="text-2xl font-bold text-ink">Why Source Used Cars from China</h2>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {whyItems.map((w) => (
        <div class="card p-5">
          <h3 class="text-base font-semibold text-ink">{w.title}</h3>
          <p class="mt-2 text-sm text-ink-soft">{w.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- REQUEST A CAR CTA -->
  <section class="bg-surface-alt py-14">
    <div class="container-site grid gap-8 lg:grid-cols-2">
      <div>
        <h2 class="text-2xl font-bold text-ink">Can't Find the Car You Need?</h2>
        <p class="mt-2 text-ink-soft">Tell us what you are looking for and we can help source it from China.</p>
        <p class="mt-4 text-sm text-ink-muted">
          Provide as much detail as you can — brand, model, year, budget and destination — and we will get back to you with sourcing options.
        </p>
      </div>
      <LeadForm variant="full" />
    </div>
  </section>

  <!-- MARKET ENTRY -->
  <section class="container-site py-14">
    <h2 class="text-2xl font-bold text-ink">Used Cars from China to</h2>
    <p class="mt-1 text-ink-soft">Explore sourcing for your destination market.</p>
    <div class="mt-6 flex flex-wrap gap-3">
      {markets.map((m) => (
        <a
          href={`${SITE.subdomains.market}/${m.slug}`}
          target="_blank"
          rel="noopener noreferrer"
          class="card px-4 py-2.5 text-sm font-medium text-ink hover:border-brand-300"
        >
          {m.name}
        </a>
      ))}
    </div>
    <p class="mt-3 text-xs text-ink-muted">Market pages are part of a future Market sub-site (market.example.com).</p>
  </section>

  <!-- DATA / TOOLS ENTRY -->
  <section class="bg-surface-alt py-14">
    <div class="container-site grid gap-5 lg:grid-cols-2">
      <a href={`${SITE.subdomains.data}`} target="_blank" rel="noopener noreferrer" class="card p-6 hover:border-brand-300">
        <h2 class="text-lg font-semibold text-ink">Vehicle Database</h2>
        <p class="mt-2 text-sm text-ink-soft">Explore detailed specifications of Chinese vehicles — a future Data sub-site.</p>
        <span class="mt-3 inline-block text-sm font-semibold text-brand-700">data.example.com →</span>
      </a>
      <a href={`${SITE.subdomains.tools}`} target="_blank" rel="noopener noreferrer" class="card p-6 hover:border-brand-300">
        <h2 class="text-lg font-semibold text-ink">Import Tools</h2>
        <p class="mt-2 text-sm text-ink-soft">Estimate the cost of importing a vehicle from China — a future Tools sub-site.</p>
        <span class="mt-3 inline-block text-sm font-semibold text-brand-700">tools.example.com →</span>
      </a>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="container-site py-14">
    <h2 class="text-2xl font-bold text-ink">How It Works</h2>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((s) => (
        <div class="card p-5">
          <span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-800 text-sm font-bold text-white">{s.n}</span>
          <h3 class="mt-3 text-base font-semibold text-ink">{s.title}</h3>
          <p class="mt-2 text-sm text-ink-soft">{s.text}</p>
        </div>
      ))}
    </div>
    <a href="/how-it-works/" class="btn-ghost mt-5">Learn more about the process →</a>
  </section>

  <!-- FINAL CTA -->
  <section class="bg-brand-900 py-16 text-center text-white">
    <div class="container-site">
      <h2 class="text-2xl font-bold sm:text-3xl">Find Your Next Vehicle from China</h2>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="/cars/" class="btn-primary">Browse Cars</a>
        <a href="/request-a-car/" class="btn-secondary !border-white/30 !bg-transparent !text-white hover:!bg-white/10">Request a Car</a>
      </div>
    </div>
  </section>
</BaseLayout>
