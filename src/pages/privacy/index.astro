---
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { CONTACT } from '../../lib/site';

const title = 'Privacy Policy — China Used Car Export';
const description = 'Privacy policy for China Used Car Export — how we handle the information you submit through our enquiry forms.';
---

<BaseLayout title={title} description={description} canonical="/privacy/">
  <Breadcrumb crumbs={[{ name: 'Home', path: '/' }, { name: 'Privacy Policy', path: '/privacy/' }]} />

  <section class="container-site py-6">
    <h1 class="text-3xl font-bold text-ink">Privacy Policy</h1>
    <div class="prose-vehicle mt-4 max-w-3xl space-y-4">
      <p><strong>Last updated:</strong> 4 October 2026</p>
      <p>
        This policy explains how {`China Used Car Export`} handles information you provide when you use this website,
        including enquiry and request forms.
      </p>
      <h2 class="text-lg font-semibold text-ink">Information we collect</h2>
      <p>
        When you submit a quote or sourcing request, we collect the details you provide — such as your name, email,
        WhatsApp number, company, and the vehicle requirements you describe. We only use this to respond to your enquiry.
      </p>
      <h2 class="text-lg font-semibold text-ink">How we use your information</h2>
      <p>
        We use your information solely to respond to your enquiry and to provide the sourcing and export services you
        request. We do not sell your information or share it with third parties for marketing.
      </p>
      <h2 class="text-lg font-semibold text-ink">Contact</h2>
      <p>
        For privacy questions, email <a href={`mailto:${CONTACT.email}`} class="text-brand-700 hover:underline">{CONTACT.email}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
