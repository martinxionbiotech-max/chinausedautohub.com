---
import type { Vehicle } from '../lib/types';
import { SITE, formatPrice } from '../lib/site';
import { getAllFuelTypes, getAllBrands, getAllBodyTypes } from '../lib/data';
import { getTranslations } from '../i18n';
import { fuelTypeName, bodyTypeName } from '../i18n/reference';
import { DEFAULT_LOCALE, type Locale } from '../lib/i18n';

interface Props {
  variant?: 'full' | 'quote';
  vehicle?: Vehicle;
  heading?: string;
  subheading?: string;
}

const {
  variant = 'full',
  vehicle,
  heading,
  subheading,
} = Astro.props;

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = getTranslations(locale);

const fuelTypes = getAllFuelTypes();
const bodyTypes = getAllBodyTypes();
const brands = getAllBrands();

const isQuote = variant === 'quote';
const defaultHeading = isQuote ? t.leadForm.quoteHeading : t.leadForm.requestHeading;
const defaultSubheading = isQuote ? t.leadForm.quoteSubheading : t.leadForm.requestSubheading;

const formId = isQuote ? 'request-quote-form' : 'request-car-form';
const endpoint = SITE.leadEndpoint || '';

// Client-side strings (validation/success) injected for the inline script.
const clientStrings = {
  errName: t.leadForm.errName,
  errEmail: t.leadForm.errEmail,
  errBrand: t.leadForm.errBrand,
  errCountry: t.leadForm.errCountry,
  success: t.leadForm.success,
  successHoneypot: t.leadForm.successHoneypot,
  errorPrefix: t.leadForm.errorGeneric,
  sending: t.common.sending,
  submit: isQuote ? t.common.requestQuote : t.common.submitRequest,
  anyModel: t.leadForm.anyModel,
  modelPlaceholder: t.leadForm.modelPlaceholder,
};
---

<section id="lead-form" class="card p-6 sm:p-8">
  <div>
    <h2 class="text-xl font-semibold text-ink">{heading ?? defaultHeading}</h2>
    <p class="mt-2 text-sm text-ink-soft">{subheading ?? defaultSubheading}</p>
  </div>

  {vehicle && (
    <div class="mt-4 rounded-md border border-surface-line bg-surface-alt p-4">
      <p class="text-sm font-semibold text-ink">{t.leadForm.vehicle}</p>
      <p class="mt-1 text-sm text-ink-soft">
        {vehicle.year} {vehicle.brand.toUpperCase()} {vehicle.model} · {formatPrice(vehicle.price, locale)}
      </p>
    </div>
  )}

  <form
    id={formId}
    class="mt-6 grid gap-4"
    method="post"
    action={endpoint || '#'}
    data-endpoint={endpoint}
    data-variant={variant}
    data-email={SITE.email}
    data-i18n={JSON.stringify(clientStrings)}
    novalidate
  >
    {/* Honeypot spam trap — hidden from humans */}
    <div class="hidden" aria-hidden="true">
      <label>{t.leadForm.leaveEmpty}<input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label>
    </div>

    {isQuote && vehicle && (
      <div class="hidden">
        <input type="hidden" name="vehicle_id" value={vehicle.vehicle_id} />
        <input type="hidden" name="brand" value={vehicle.brand} />
        <input type="hidden" name="model" value={vehicle.model} />
        <input type="hidden" name="year" value={String(vehicle.year)} />
        <input type="hidden" name="price" value={`${vehicle.price.amount} ${vehicle.price.currency}`} />
      </div>
    )}

    <div class="grid gap-4 sm:grid-cols-2">
      {!isQuote && (
        <div class="sm:col-span-2">
          <label class="flex items-center gap-2 text-sm text-ink-soft">
            <input type="checkbox" id="unknown-model" name="unknown_model" class="h-4 w-4 rounded border-surface-line" />
            {t.leadForm.unknownModel}
          </label>
        </div>
      )}

      <div>
        <label for={`${formId}-brand`} class="label">{t.leadForm.brand} {!isQuote && <span class="text-red-600">*</span>}</label>
        {isQuote ? (
          <input id={`${formId}-brand`} name="brand" value={vehicle?.brand.toUpperCase()} readonly class="input bg-surface-alt" />
        ) : (
          <select id={`${formId}-brand`} name="brand" class="input">
            <option value="">{t.leadForm.anyBrand}</option>
            {brands.map((b) => <option value={b.slug}>{b.name}</option>)}
          </select>
        )}
      </div>

      <div>
        <label for={`${formId}-model`} class="label">{t.leadForm.model}</label>
        <input id={`${formId}-model`} name="model" type="text" value={vehicle?.model} readonly={isQuote} class:list={['input', isQuote && 'bg-surface-alt']} placeholder={t.leadForm.modelPlaceholder} />
      </div>

      <div>
        <label for={`${formId}-year`} class="label">{t.leadForm.preferredYear}</label>
        <input id={`${formId}-year`} name="year" type="number" min="2000" max="2026" value={vehicle?.year} readonly={isQuote} class:list={['input', isQuote && 'bg-surface-alt']} placeholder={t.leadForm.yearPlaceholder} />
      </div>

      <div>
        <label for={`${formId}-budget`} class="label">{t.leadForm.budget}</label>
        <input id={`${formId}-budget`} name="budget" type="number" min="0" class="input" placeholder={t.leadForm.budgetPlaceholder} />
      </div>

      <div>
        <label for={`${formId}-mileage`} class="label">{t.leadForm.maxMileage}</label>
        <input id={`${formId}-mileage`} name="mileage" type="number" min="0" class="input" placeholder={t.leadForm.mileagePlaceholder} />
      </div>

      <div>
        <label for={`${formId}-fuel`} class="label">{t.leadForm.fuelType}</label>
        <select id={`${formId}-fuel`} name="fuel" class="input">
          <option value="">{t.leadForm.any}</option>
          {fuelTypes.map((f) => <option value={f.slug}>{fuelTypeName(f.slug, locale, f.name)}</option>)}
        </select>
      </div>

      {!isQuote && (
        <div>
          <label for={`${formId}-body`} class="label">{t.leadForm.bodyType}</label>
          <select id={`${formId}-body`} name="body_type" class="input">
            <option value="">{t.leadForm.any}</option>
            {bodyTypes.map((b) => <option value={b.slug}>{bodyTypeName(b.slug, locale, b.name)}</option>)}
          </select>
        </div>
      )}

      <div>
        <label for={`${formId}-qty`} class="label">{t.leadForm.quantity}</label>
        <input id={`${formId}-qty`} name="quantity" type="number" min="1" value="1" class="input" />
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label for={`${formId}-country`} class="label">{t.leadForm.destinationCountry} {!isQuote && <span class="text-red-600">*</span>}</label>
        <input id={`${formId}-country`} name="country" type="text" class="input" placeholder={t.leadForm.countryPlaceholder} />
      </div>
      <div>
        <label for={`${formId}-port`} class="label">{t.leadForm.destinationPort}</label>
        <input id={`${formId}-port`} name="port" type="text" class="input" placeholder={t.leadForm.portPlaceholder} />
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label for={`${formId}-company`} class="label">{t.leadForm.companyName}</label>
        <input id={`${formId}-company`} name="company" type="text" class="input" autocomplete="organization" />
      </div>
      <div>
        <label for={`${formId}-name`} class="label">{t.leadForm.name} <span class="text-red-600">*</span></label>
        <input id={`${formId}-name`} name="name" type="text" required class="input" autocomplete="name" />
      </div>
      <div>
        <label for={`${formId}-email`} class="label">{t.leadForm.email} <span class="text-red-600">*</span></label>
        <input id={`${formId}-email`} name="email" type="email" required class="input" autocomplete="email" />
      </div>
      <div>
        <label for={`${formId}-whatsapp`} class="label">{t.leadForm.whatsapp}</label>
        <input id={`${formId}-whatsapp`} name="whatsapp" type="tel" class="input" placeholder={t.leadForm.whatsappPlaceholder} />
      </div>
    </div>

    <div>
      <label for={`${formId}-message`} class="label">{t.leadForm.message}</label>
      <textarea id={`${formId}-message`} name="message" rows="4" class="input" placeholder={t.leadForm.messagePlaceholder}></textarea>
    </div>

    <div aria-live="polite">
      <p id={`${formId}-error`} class="hidden text-sm text-red-600" role="alert"></p>
      <p id={`${formId}-success`} class="hidden text-sm text-green-700" role="status"></p>
    </div>

    <div>
      <button type="submit" class="btn-primary w-full sm:w-auto" id={`${formId}-submit`}>
        {isQuote ? t.common.requestQuote : t.common.submitRequest}
      </button>
      <p class="mt-2 text-xs text-ink-muted">
        {t.leadForm.privacyNote}
      </p>
    </div>
  </form>
</section>

<script is:inline>
  (() => {
    const form = document.getElementById('request-quote-form') || document.getElementById('request-car-form');
    if (!form) return;
    const fid = form.id;
    const variant = form.dataset.variant || 'full';
    const isQuote = variant === 'quote';
    const supportEmail = form.dataset.email || '';
    const S = (() => { try { return JSON.parse(form.dataset.i18n || '{}'); } catch { return {}; } })();

    const errEl = document.getElementById(fid + '-error');
    const okEl = document.getElementById(fid + '-success');
    const submitBtn = document.getElementById(fid + '-submit');
    const unknownModel = document.getElementById('unknown-model');

    const brandSel = document.getElementById(fid + '-brand');
    const modelInp = document.getElementById(fid + '-model');

    if (unknownModel) {
      unknownModel.addEventListener('change', () => {
        const off = unknownModel.checked;
        if (brandSel) brandSel.disabled = off;
        if (modelInp) { modelInp.disabled = off; modelInp.placeholder = off ? (S.anyModel || 'Any model') : (S.modelPlaceholder || 'e.g. Song Plus'); }
      });
    }

    function setError(msg) {
      if (msg) { errEl.textContent = msg; errEl.classList.remove('hidden'); }
      else errEl.classList.add('hidden');
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      setError('');
      okEl.classList.add('hidden');

      const fd = new FormData(form);

      if (fd.get('company_website')) {
        okEl.textContent = S.successHoneypot || 'Thank you, your request has been received.';
        okEl.classList.remove('hidden');
        form.reset();
        return;
      }

      const name = String(fd.get('name') || '').trim();
      const email = String(fd.get('email') || '').trim();
      const country = String(fd.get('country') || '').trim();
      const brand = String(fd.get('brand') || '').trim();
      const skipVehicle = unknownModel ? unknownModel.checked : false;

      if (!name) { setError(S.errName || 'Please enter your name.'); return; }
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { setError(S.errEmail || 'Please enter a valid email address.'); return; }
      if (!isQuote && !skipVehicle && !brand) { setError(S.errBrand || 'Please select a brand.'); return; }
      if (!isQuote && !country) { setError(S.errCountry || 'Please enter a destination country.'); return; }

      submitBtn.disabled = true;
      submitBtn.textContent = S.sending || 'Sending…';

      const payload = Object.fromEntries(fd.entries());
      const endpoint = form.dataset.endpoint;

      try {
        if (endpoint) {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (!res.ok) throw new Error('request failed');
        } else {
          await new Promise((r) => setTimeout(r, 400));
        }
        okEl.textContent = S.success || 'Thank you — your request has been received.';
        okEl.classList.remove('hidden');
        form.reset();
        if (unknownModel) { unknownModel.checked = false; if (brandSel) brandSel.disabled = false; if (modelInp) modelInp.disabled = false; }
      } catch {
        setError((S.errorPrefix || 'Something went wrong.') + ' ' + supportEmail + '.');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = S.submit || (isQuote ? 'Request Quote' : 'Submit Request');
      }
    });
  })();
</script>
