---
import { SITE, CONTACT, LEGAL_NAV, RESOURCE_NAV } from '../lib/site';

const browse = [
  { label: 'Browse Vehicles', href: '/cars/' },
  { label: 'Brands', href: '/brands/' },
  { label: 'Vehicle Types', href: '/body-types/' },
  { label: 'New Arrivals', href: '/new-arrivals/' },
  { label: 'Request a Car', href: '/request-a-car/' },
  { label: 'How It Works', href: '/how-it-works/' },
];

const company = [
  { label: 'About', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];

const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-surface-line bg-surface-alt">
  <div class="container-site grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <a href="/" class="flex items-center gap-2.5">
        <span class="flex h-8 w-8 items-center justify-center rounded bg-brand-800 text-white text-sm font-bold">CU</span>
        <span class="text-sm font-bold text-ink">{SITE.name}</span>
      </a>
      <p class="mt-3 text-sm leading-6 text-ink-muted">
        Source quality used and near-new vehicles from China for export to your market.
      </p>
      <div class="mt-4 space-y-1 text-sm">
        <p class="text-ink-soft">
          Email: <a href={`mailto:${CONTACT.email}`} class="text-brand-700 hover:underline">{CONTACT.email}</a>
        </p>
        <p class="text-ink-soft">
          WhatsApp: <a href={CONTACT.whatsappLink} target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:underline">{CONTACT.whatsapp}</a>
        </p>
      </div>
    </div>

    <nav aria-label="Browse">
      <h3 class="text-sm font-semibold text-ink">Browse</h3>
      <ul class="mt-3 space-y-2">
        {browse.map((l) => (
          <li><a href={l.href} class="text-sm text-ink-soft hover:text-brand-700">{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav aria-label="Company">
      <h3 class="text-sm font-semibold text-ink">Company</h3>
      <ul class="mt-3 space-y-2">
        {company.map((l) => (
          <li><a href={l.href} class="text-sm text-ink-soft hover:text-brand-700">{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <h3 class="text-sm font-semibold text-ink">Related Resources</h3>
      <ul class="mt-3 space-y-2">
        {RESOURCE_NAV.map((l) => (
          <li>
            <a href={l.href} target="_blank" rel="noopener noreferrer" class="text-sm text-ink-soft hover:text-brand-700">
              {l.label}
            </a>
            <span class="block text-[11px] text-ink-muted">{l.note}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-surface-line">
    <div class="container-site flex flex-col gap-3 py-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-ink-muted">© {year} {SITE.name}. All rights reserved.</p>
      <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Legal">
        {LEGAL_NAV.map((l) => (
          <a href={l.href} class="text-sm text-ink-muted hover:text-brand-700">{l.label}</a>
        ))}
      </nav>
    </div>
  </div>
</footer>
