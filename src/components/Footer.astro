---
import { SITE, CONTACT, SUBDOMAINS, LEGAL_NAV } from '../lib/site';
import { getTranslations } from '../i18n';
import { DEFAULT_LOCALE, localizedUrl, type Locale } from '../lib/i18n';

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = getTranslations(locale);

const browse = [
  { label: t.footer.browseVehicles, href: localizedUrl('/cars/', locale) },
  { label: t.nav.brands, href: localizedUrl('/brands/', locale) },
  { label: t.nav.vehicleTypes, href: localizedUrl('/body-types/', locale) },
  { label: t.nav.powertrains, href: localizedUrl('/powertrains/', locale) },
  { label: t.nav.markets, href: localizedUrl('/markets/', locale) },
  { label: t.nav.newArrivals, href: localizedUrl('/new-arrivals/', locale) },
  { label: t.nav.sourcing, href: localizedUrl('/sourcing/', locale) },
  { label: t.nav.services, href: localizedUrl('/services/', locale) },
  { label: t.nav.guides, href: localizedUrl('/guides/', locale) },
  { label: t.nav.requestACar, href: localizedUrl('/contact/', locale) },
  { label: t.nav.howItWorks, href: localizedUrl('/how-it-works/', locale) },
];

const company = [
  { label: t.footer.about, href: localizedUrl('/about/', locale) },
  { label: t.footer.contact, href: localizedUrl('/contact/', locale) },
  { label: t.nav.trust, href: localizedUrl('/trust/', locale) },
  { label: t.nav.faq, href: localizedUrl('/faq/', locale) },
];

const hostOf = (url: string) => {
  try {
    return new URL(url).host;
  } catch {
    return url;
  }
};

const resources = [
  { label: t.nav.vehicleData, note: hostOf(SUBDOMAINS.data), href: SUBDOMAINS.data },
  { label: t.nav.marketInformation, note: hostOf(SUBDOMAINS.market), href: SUBDOMAINS.market },
  { label: t.nav.tools, note: hostOf(SUBDOMAINS.tools), href: SUBDOMAINS.tools },
  { label: t.nav.companies, note: hostOf(SUBDOMAINS.companies), href: SUBDOMAINS.companies },
];

const legalLink = (l: { crumbKey: string; path: string }) => ({
  label: (t.breadcrumb as Record<string, string>)[l.crumbKey] ?? l.crumbKey,
  href: localizedUrl(l.path, locale),
});

const legalGroup = LEGAL_NAV.legal.map(legalLink);
const disclaimersGroup = LEGAL_NAV.disclaimers.map(legalLink);

const homeHref = localizedUrl('/', locale);
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-surface-line bg-surface-alt">
  <div class="container-site grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <a href={homeHref} class="flex items-center gap-2.5">
        <span class="flex h-8 w-8 items-center justify-center rounded bg-brand-800 text-white text-sm font-bold">CU</span>
        <span class="text-sm font-bold text-ink">{SITE.name}</span>
      </a>
      <p class="mt-3 text-sm leading-6 text-ink-muted">
        {t.footer.tagline}
      </p>
      <div class="mt-4 space-y-1 text-sm">
        <p class="text-ink-soft">
          {t.footer.email}: <a href={`mailto:${CONTACT.email}`} class="text-brand-700 hover:underline">{CONTACT.email}</a>
        </p>
        <p class="text-ink-soft">
          {t.footer.whatsapp}: <a href={CONTACT.whatsappLink} target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:underline">{CONTACT.whatsapp}</a>
        </p>
      </div>
    </div>

    <nav aria-label={t.footer.browse}>
      <h3 class="text-sm font-semibold text-ink">{t.footer.browse}</h3>
      <ul class="mt-3 space-y-2">
        {browse.map((l) => (
          <li><a href={l.href} class="text-sm text-ink-soft hover:text-brand-700">{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav aria-label={t.footer.company}>
      <h3 class="text-sm font-semibold text-ink">{t.footer.company}</h3>
      <ul class="mt-3 space-y-2">
        {company.map((l) => (
          <li><a href={l.href} class="text-sm text-ink-soft hover:text-brand-700">{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <h3 class="text-sm font-semibold text-ink">{t.footer.relatedResources}</h3>
      <ul class="mt-3 space-y-2">
        {resources.map((l) => (
          <li>
            <a href={l.href} target="_blank" rel="noopener noreferrer" class="text-sm text-ink-soft hover:text-brand-700">
              {l.label}
            </a>
            <span class="block text-[11px] text-ink-muted">{l.note}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-surface-line">
    <div class="container-site py-6">
      <div class="grid gap-6 sm:grid-cols-2">
        <nav aria-label={t.footer.legal}>
          <h3 class="text-xs font-semibold uppercase tracking-wide text-ink-muted">{t.footer.legal}</h3>
          <ul class="mt-2 grid grid-cols-2 gap-x-5 gap-y-1.5">
            {legalGroup.map((l) => (
              <li><a href={l.href} class="text-xs text-ink-muted hover:text-brand-700">{l.label}</a></li>
            ))}
          </ul>
        </nav>
        <nav aria-label={t.footer.disclaimers}>
          <h3 class="text-xs font-semibold uppercase tracking-wide text-ink-muted">{t.footer.disclaimers}</h3>
          <ul class="mt-2 grid grid-cols-2 gap-x-5 gap-y-1.5">
            {disclaimersGroup.map((l) => (
              <li><a href={l.href} class="text-xs text-ink-muted hover:text-brand-700">{l.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
      <p class="mt-6 text-sm text-ink-muted">© {year} {SITE.name}. {t.footer.allRightsReserved}</p>
    </div>
  </div>
</footer>
