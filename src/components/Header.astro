---
import { SITE, SUBDOMAINS } from '../lib/site';
import { getTranslations } from '../i18n';
import { LOCALES, DEFAULT_LOCALE, localizedPath, localizedUrl, type Locale } from '../lib/i18n';

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = getTranslations(locale);
const path = Astro.url.pathname;

interface NavChild {
  label: string;
  href: string;
}
interface NavItem {
  label: string;
  href: string;
  children?: NavChild[];
}

const navItems: NavItem[] = [
  {
    label: t.nav.vehicles,
    href: localizedUrl('/cars/', locale),
    children: [
      { label: t.nav.availableVehicles, href: localizedUrl('/cars/', locale) },
      { label: t.nav.vehicleTypes, href: localizedUrl('/body-types/', locale) },
      { label: t.nav.powertrains, href: localizedUrl('/powertrains/', locale) },
      { label: t.nav.newArrivals, href: localizedUrl('/new-arrivals/', locale) },
    ],
  },
  { label: t.nav.brands, href: localizedUrl('/brands/', locale) },
  { label: t.nav.markets, href: localizedUrl('/markets/', locale) },
  { label: t.nav.services, href: localizedUrl('/services/', locale) },
  { label: t.nav.requestACar, href: localizedUrl('/request-a-car/', locale) },
  { label: t.nav.howItWorks, href: localizedUrl('/how-it-works/', locale) },
];

const hostOf = (url: string) => {
  try {
    return new URL(url).host;
  } catch {
    return url;
  }
};

const resources = [
  { label: t.nav.vehicleData, note: hostOf(SUBDOMAINS.data), href: SUBDOMAINS.data },
  { label: t.nav.marketInformation, note: hostOf(SUBDOMAINS.market), href: SUBDOMAINS.market },
  { label: t.nav.tools, note: hostOf(SUBDOMAINS.tools), href: SUBDOMAINS.tools },
  { label: t.nav.companies, note: hostOf(SUBDOMAINS.companies), href: SUBDOMAINS.companies },
];

const homeHref = localizedUrl('/', locale);

function isActive(item: NavItem): boolean {
  if (item.children) return item.children.some((c) => c.href !== '/' && path.startsWith(c.href));
  if (item.href === '/' || item.href === `/${locale}/`) return path === homeHref;
  return item.href !== '/' && path.startsWith(item.href);
}
---

<header class="sticky top-0 z-50 border-b border-surface-line bg-white/95 backdrop-blur">
  <div class="container-site flex h-16 items-center justify-between gap-4">
    <a href={homeHref} class="flex items-center gap-2.5 shrink-0" aria-label={SITE.name}>
      <span class="flex h-8 w-8 items-center justify-center rounded bg-brand-800 text-white text-sm font-bold">CU</span>
      <span class="hidden sm:block leading-tight">
        <span class="block text-sm font-bold text-ink">{SITE.name}</span>
        <span class="block text-[11px] text-ink-muted">{t.site.tagline}</span>
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label={t.nav.primary}>
      {navItems.map((item) =>
        item.children ? (
          <details class="relative group">
            <summary
              class:list={[
                'nav-dropdown-summary px-3 py-2 text-sm font-medium rounded-md transition-colors',
                isActive(item) ? 'bg-brand-50 text-brand-800' : 'text-ink-soft hover:text-ink hover:bg-surface-alt',
              ]}
            >
              {item.label}
              <svg class="chevron ms-1" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <div class="absolute start-0 top-full mt-1.5 w-56 rounded-lg border border-surface-line bg-white p-1.5 shadow-md">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  class:list={[
                    'block px-3 py-2 text-sm font-medium rounded-md',
                    isActive({ label: child.label, href: child.href })
                      ? 'bg-brand-50 text-brand-800'
                      : 'text-ink-soft hover:text-ink hover:bg-surface-alt',
                  ]}
                >
                  {child.label}
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a
            href={item.href}
            class:list={[
              'px-3 py-2 text-sm font-medium rounded-md transition-colors',
              isActive(item) ? 'bg-brand-50 text-brand-800' : 'text-ink-soft hover:text-ink hover:bg-surface-alt',
            ]}
          >
            {item.label}
          </a>
        ),
      )}
    </nav>

    <details class="relative hidden xl:block group">
      <summary class="nav-dropdown-summary inline-flex items-center gap-2 rounded-md border border-dashed border-surface-line px-3 py-1.5 text-xs font-semibold text-ink-muted uppercase tracking-wide">
        {t.nav.resources}
        <svg class="chevron" width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </summary>
      <div class="absolute end-0 top-full mt-1.5 w-64 rounded-lg border border-surface-line bg-white p-1.5 shadow-md">
        <a href={localizedUrl('/guides/', locale)} class="block rounded-md px-3 py-2">
          <span class="block text-sm font-medium text-ink-soft hover:text-brand-700">{t.nav.guides}</span>
        </a>
        {resources.map((item) => (
          <a
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
            class="block rounded-md px-3 py-2"
          >
            <span class="block text-sm font-medium text-ink-soft hover:text-brand-700">{item.label}</span>
            <span class="block text-[11px] text-ink-muted">{item.note}</span>
          </a>
        ))}
      </div>
    </details>

    <div class="flex items-center gap-2">
      <!-- Language switcher -->
      <details class="relative group">
        <summary
          class="inline-flex h-10 items-center gap-1.5 rounded-md border border-surface-line px-2.5 text-sm text-ink-soft hover:text-ink"
          aria-label={t.nav.language}
        >
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="10" cy="10" r="7.5" stroke="currentColor" stroke-width="1.4" />
            <ellipse cx="10" cy="10" rx="3.5" ry="7.5" stroke="currentColor" stroke-width="1.2" />
            <path d="M2.8 10h14.4" stroke="currentColor" stroke-width="1.2" />
          </svg>
          <span class="hidden sm:inline font-semibold uppercase">{locale}</span>
          <svg class="chevron" width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div class="absolute end-0 top-full mt-1.5 w-44 rounded-lg border border-surface-line bg-white p-1.5 shadow-md">
          {LOCALES.map((l) => (
            <a
              href={localizedPath(path, l.code)}
              class:list={[
                'flex items-center justify-between rounded-md px-3 py-2 text-sm font-medium',
                l.code === locale ? 'bg-brand-50 text-brand-800' : 'text-ink-soft hover:bg-surface-alt',
              ]}
              hreflang={l.code}
              lang={l.code}
            >
              <span>{l.label}</span>
              {l.code === locale && (
                <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="m5 10 3.5 3.5L15 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </a>
          ))}
        </div>
      </details>

      <a href={localizedUrl('/request-a-car/', locale)} class="btn-primary hidden sm:inline-flex">{t.common.requestACar}</a>
      <button
        id="nav-toggle"
        class="lg:hidden inline-flex h-10 w-10 items-center justify-center rounded-md border border-surface-line text-ink"
        aria-label={t.nav.openMenu}
        data-open={t.nav.openMenu}
        data-close={t.nav.closeMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-surface-line bg-white">
    <nav class="container-site flex flex-col py-3" aria-label={t.nav.mobile}>
      {navItems.map((item) =>
        item.children ? (
          <details class="group">
            <summary
              class:list={[
                'nav-dropdown-summary flex items-center justify-between px-3 py-2.5 text-sm font-medium rounded-md',
                isActive(item) ? 'bg-brand-50 text-brand-800' : 'text-ink-soft hover:bg-surface-alt',
              ]}
            >
              {item.label}
              <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <div class="flex flex-col ps-3">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  class:list={[
                    'px-3 py-2 text-sm font-medium rounded-md',
                    isActive({ label: child.label, href: child.href })
                      ? 'bg-brand-50 text-brand-800'
                      : 'text-ink-soft hover:bg-surface-alt',
                  ]}
                >
                  {child.label}
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a
            href={item.href}
            class:list={[
              'px-3 py-2.5 text-sm font-medium rounded-md',
              isActive(item) ? 'bg-brand-50 text-brand-800' : 'text-ink-soft hover:bg-surface-alt',
            ]}
          >
            {item.label}
          </a>
        ),
      )}
      <div class="my-2 border-t border-surface-line"></div>
      <details class="group">
        <summary class="nav-dropdown-summary flex items-center justify-between px-3 py-2 text-[11px] font-semibold uppercase tracking-wide text-ink-muted">
          {t.nav.resources}
          <svg class="chevron" width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div class="flex flex-col ps-3">
          <a href={localizedUrl('/guides/', locale)} class="px-3 py-2 text-sm font-medium text-ink-muted hover:text-brand-700">
            {t.nav.guides}
          </a>
          {resources.map((item) => (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-2 text-sm font-medium text-ink-muted hover:text-brand-700"
            >
              {item.label}
              <span class="text-[11px] text-ink-muted"> — {item.note}</span>
            </a>
          ))}
        </div>
      </details>
      <div class="my-2 border-t border-surface-line"></div>
      <p class="px-3 py-1 text-[11px] font-semibold uppercase tracking-wide text-ink-muted">{t.nav.language}</p>
      <div class="flex flex-wrap gap-1 px-2 pb-2">
        {LOCALES.map((l) => (
          <a
            href={localizedPath(path, l.code)}
            class:list={[
              'rounded-md px-3 py-2 text-sm font-medium',
              l.code === locale ? 'bg-brand-50 text-brand-800' : 'text-ink-soft hover:bg-surface-alt',
            ]}
            hreflang={l.code}
            lang={l.code}
          >
            {l.label}
          </a>
        ))}
      </div>
    </nav>
  </div>
</header>

<style is:global>
  .nav-dropdown-summary {
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .nav-dropdown-summary::-webkit-details-marker {
    display: none;
  }
  details[open] > .nav-dropdown-summary .chevron,
  details[open] > summary .chevron {
    transform: rotate(180deg);
  }
  .chevron {
    transition: transform 160ms ease;
  }
</style>

<script is:inline>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? (toggle.dataset.close || 'Close menu') : (toggle.dataset.open || 'Open menu'));
    });
  }
  // Close other dropdowns when one opens.
  const dropdowns = document.querySelectorAll('header details');
  dropdowns.forEach((d) => {
    d.addEventListener('toggle', () => {
      if (d.open) {
        dropdowns.forEach((other) => {
          if (other !== d) other.open = false;
        });
      }
    });
  });
</script>
