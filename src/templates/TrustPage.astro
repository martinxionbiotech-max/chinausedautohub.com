---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getTranslations } from '../i18n';
import { TRUST_PAGE } from '../i18n/trust';
import { pick } from '../i18n/l10n';
import { trustUrl } from '../lib/urls';
import { DEFAULT_LOCALE, localizedUrl, type Locale } from '../lib/i18n';

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = getTranslations(locale);

const title = pick(TRUST_PAGE.title, locale);
const description = pick(TRUST_PAGE.description, locale);
const h1 = pick(TRUST_PAGE.h1, locale);
const intro = pick(TRUST_PAGE.intro, locale);
---

<BaseLayout title={title} description={description} canonical={localizedUrl(trustUrl(), locale)}>
  <Breadcrumb crumbs={[{ name: t.breadcrumb.home, path: localizedUrl('/', locale) }, { name: t.breadcrumb.trust, path: localizedUrl(trustUrl(), locale) }]} />

  <section class="container-site py-6">
    <h1 class="text-3xl font-bold text-ink">{h1}</h1>
    <p class="mt-2 max-w-3xl text-ink-soft">{intro}</p>
  </section>

  <section class="container-site">
    <h2 class="text-xl font-bold text-ink">{pick(TRUST_PAGE.confidenceHeading, locale)}</h2>
    <p class="mt-2 max-w-3xl text-ink-soft">{pick(TRUST_PAGE.confidenceIntro, locale)}</p>
    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      {TRUST_PAGE.confidenceLevels.map((level) => (
        <div class="card p-5">
          <span class="inline-flex rounded bg-brand-50 px-2 py-0.5 text-xs font-semibold text-brand-800">{pick(level.label, locale)}</span>
          <p class="mt-3 text-sm text-ink-soft">{pick(level.text, locale)}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-site mt-12 max-w-3xl pb-10">
    <div class="space-y-8">
      {TRUST_PAGE.sections.map((section) => (
        <section>
          <h2 class="text-xl font-bold text-ink">{pick(section.heading, locale)}</h2>
          <div class="prose-vehicle mt-3 space-y-3">
            {section.paragraphs.map((p) => <p>{pick(p, locale)}</p>)}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
