---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE, CONTACT, LEGAL_PAGES } from '../lib/site';
import { getTranslations } from '../i18n';
import { DEFAULT_LOCALE, localizedUrl, type Locale } from '../lib/i18n';

interface Props {
  variant: string; // legal page slug (see LEGAL_PAGES in lib/site.ts)
}

const { variant } = Astro.props;
const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = getTranslations(locale);

const meta = LEGAL_PAGES.find((p) => p.slug === variant);
if (!meta) throw new Error(`Unknown legal page variant: ${variant}`);
const page = t.legal[meta.key as keyof typeof t.legal] as {
  title: string;
  description: string;
  h1: string;
  intro?: string;
  sections: { h: string; p: string[] }[];
};
const label = (t.breadcrumb as Record<string, string>)[meta.crumbKey] ?? page.h1;

// Render a translated paragraph, substituting trusted placeholders.
function render(p: string): string {
  return p
    .replaceAll('{siteName}', SITE.name)
    .replace('{email}', `<a href="mailto:${CONTACT.email}" class="text-brand-700 hover:underline">${CONTACT.email}</a>`)
    .replace('{whatsapp}', `<a href="${CONTACT.whatsappLink}" target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:underline">${CONTACT.whatsapp}</a>`);
}
---

<BaseLayout title={page.title} description={page.description} canonical={localizedUrl(meta.path, locale)}>
  <Breadcrumb crumbs={[{ name: t.breadcrumb.home, path: localizedUrl('/', locale) }, { name: label, path: localizedUrl(meta.path, locale) }]} />

  <section class="container-site py-6">
    <h1 class="text-3xl font-bold text-ink">{page.h1}</h1>
    <div class="prose-vehicle mt-4 max-w-3xl space-y-4">
      <p><strong>{t.legal.lastUpdated}</strong></p>
      {page.intro && <p set:html={render(page.intro)} />}
      {page.sections.map((s) => (
        <>
          <h2 class="text-lg font-semibold text-ink">{s.h}</h2>
          {s.p.map((p) => <p set:html={render(p)} />)}
        </>
      ))}
    </div>
  </section>
</BaseLayout>
