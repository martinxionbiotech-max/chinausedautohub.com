---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getTranslations } from '../i18n';
import { guideUrl } from '../lib/urls';
import { DEFAULT_LOCALE, localizedUrl, type Locale } from '../lib/i18n';

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = getTranslations(locale);
---

<BaseLayout title={t.howItWorks.title} description={t.howItWorks.description} canonical={localizedUrl('/how-it-works/', locale)}>
  <Breadcrumb crumbs={[{ name: t.breadcrumb.home, path: localizedUrl('/', locale) }, { name: t.breadcrumb.howItWorks, path: localizedUrl('/how-it-works/', locale) }]} />

  <section class="container-site py-6">
    <h1 class="text-3xl font-bold text-ink">{t.howItWorks.h1}</h1>
    <p class="mt-2 max-w-2xl text-ink-soft">{t.howItWorks.intro}</p>
  </section>

  <section class="container-site">
    <p class="max-w-2xl text-sm text-ink-muted">{t.howItWorks.ownerLegend}</p>
    <ol class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
      {t.howItWorks.steps.map((s) => (
        <li class="card p-5">
          <span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-800 text-sm font-bold text-white">{s.n}</span>
          <h2 class="mt-3 text-base font-semibold text-ink">{s.title}</h2>
          <p class="mt-2 text-sm text-ink-soft">{s.text}</p>
          <span class:list={[
            'mt-3 inline-block rounded px-2 py-0.5 text-xs font-semibold',
            s.owner === 'platform' ? 'bg-brand-50 text-brand-800'
            : s.owner === 'third-party' ? 'bg-amber-50 text-amber-700'
            : 'bg-sky-50 text-sky-700',
          ]}>
            {s.owner === 'platform' ? t.howItWorks.ownerPlatform : s.owner === 'third-party' ? t.howItWorks.ownerThirdParty : t.howItWorks.ownerBoth}
          </span>
        </li>
      ))}
    </ol>
  </section>

  <section class="container-site mt-12">
    <h2 class="text-xl font-bold text-ink">{t.howItWorks.whatWeProvide}</h2>
    <div class="mt-4 grid gap-5 sm:grid-cols-2">
      {t.howItWorks.areas.map((a) => (
        <div class="card p-5">
          <h3 class="text-base font-semibold text-ink">{a.title}</h3>
          <p class="mt-2 text-sm text-ink-soft">{a.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-site mt-12 max-w-3xl">
    <h2 class="text-xl font-bold text-ink">{t.howItWorks.faqHeading}</h2>
    <div class="mt-4 space-y-3">
      {t.howItWorks.faqs.map((f) => (
        <details class="card p-4">
          <summary class="cursor-pointer text-sm font-semibold text-ink">{f.question}</summary>
          <p class="mt-2 text-sm text-ink-soft">{f.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="container-site mt-12 max-w-3xl">
    <div class="card p-6">
      <h2 class="text-lg font-semibold text-ink">{t.howItWorks.buyerGuideLink}</h2>
      <p class="mt-2 text-sm text-ink-soft">{t.howItWorks.buyerGuideNote}</p>
      <a href={localizedUrl(guideUrl('how-to-buy-used-car-from-china'), locale)} class="btn-secondary mt-4">{t.howItWorks.buyerGuideLink} {t.common.arrow}</a>
    </div>
  </section>

  <section class="container-site mt-12 pb-4">
    <div class="card p-6 text-center">
      <h2 class="text-lg font-semibold text-ink">{t.howItWorks.ready}</h2>
      <div class="mt-4 flex flex-wrap justify-center gap-3">
        <a href={localizedUrl('/cars/', locale)} class="btn-primary">{t.common.browseCars}</a>
        <a href={localizedUrl('/contact/', locale)} class="btn-secondary">{t.common.requestACar}</a>
      </div>
    </div>
  </section>
</BaseLayout>
