---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getTranslations } from '../i18n';
import { SERVICES, SERVICE_SECTION_HEADINGS, getService } from '../i18n/services';
import { pick } from '../i18n/l10n';
import { serviceUrl, servicesUrl } from '../lib/urls';
import { DEFAULT_LOCALE, localizedUrl, type Locale } from '../lib/i18n';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = getTranslations(locale);

const service = getService(slug);
if (!service) {
  return Astro.redirect(localizedUrl(servicesUrl(), locale));
}

const title = pick(service.title, locale);
const description = pick(service.description, locale);
const h1 = pick(service.h1, locale);
const intro = pick(service.intro, locale);

const SERVICE_IMAGES: Record<string, string> = {
  'vehicle-sourcing': 'service-sourcing-800x533',
  'vehicle-inspection': 'service-inspection-800x533',
  'export-documentation': 'service-documentation-800x533',
  'shipping': 'service-shipping-800x533',
  'port-handling': 'service-port-handling-800x533',
};
const serviceImage = SERVICE_IMAGES[slug] ?? 'og-default-1200x630';

const heading = (k: string) => pick(SERVICE_SECTION_HEADINGS[k], locale);
const list = (items: { en: string; ar: string; ru: string; es: string }[]) =>
  items.map((it) => pick(it, locale));
---

<BaseLayout title={title} description={description} canonical={localizedUrl(serviceUrl(slug), locale)}>
  <Breadcrumb crumbs={[{ name: t.breadcrumb.home, path: localizedUrl('/', locale) }, { name: t.breadcrumb.services, path: localizedUrl(servicesUrl(), locale) }, { name: h1, path: localizedUrl(serviceUrl(slug), locale) }]} />

  <section class="container-site py-6">
    <h1 class="text-3xl font-bold text-ink">{h1}</h1>
    <p class="mt-2 max-w-3xl text-ink-soft">{intro}</p>
    <img
      src={`/images/${serviceImage}.webp`}
      alt={h1}
      width="800"
      height="533"
      loading="lazy"
      decoding="async"
      class="mt-4 w-full max-w-3xl rounded-lg object-cover"
    />
  </section>

  <section class="container-site grid gap-5 lg:grid-cols-2">
    <div class="card p-5">
      <h2 class="text-lg font-semibold text-ink">{heading('whatIs')}</h2>
      <p class="mt-2 text-sm text-ink-soft">{pick(service.whatIs, locale)}</p>
    </div>
    <div class="card p-5">
      <h2 class="text-lg font-semibold text-ink">{heading('whoFor')}</h2>
      <p class="mt-2 text-sm text-ink-soft">{pick(service.whoFor, locale)}</p>
    </div>
  </section>

  <section class="container-site mt-8 grid gap-5 md:grid-cols-2">
    <div class="card p-5">
      <h2 class="text-lg font-semibold text-ink">{heading('included')}</h2>
      <ul class="mt-3 space-y-2">
        {list(service.included).map((item) => (
          <li class="flex gap-2 text-sm text-ink-soft"><span class="text-brand-700">✓</span><span>{item}</span></li>
        ))}
      </ul>
    </div>
    <div class="card p-5">
      <h2 class="text-lg font-semibold text-ink">{heading('notIncluded')}</h2>
      <ul class="mt-3 space-y-2">
        {list(service.notIncluded).map((item) => (
          <li class="flex gap-2 text-sm text-ink-soft"><span class="text-ink-muted">–</span><span>{item}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="container-site mt-8 grid gap-5 md:grid-cols-2">
    <div class="card p-5">
      <h2 class="text-lg font-semibold text-ink">{heading('infoRequired')}</h2>
      <ul class="mt-3 list-disc ps-5 space-y-2">
        {list(service.infoRequired).map((item) => (
          <li class="text-sm text-ink-soft">{item}</li>
        ))}
      </ul>
    </div>
    <div class="card p-5">
      <h2 class="text-lg font-semibold text-ink">{heading('nextSteps')}</h2>
      <ol class="mt-3 space-y-2">
        {list(service.nextSteps).map((item, i) => (
          <li class="flex gap-2 text-sm text-ink-soft">
            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-800 text-[11px] font-bold text-white">{i + 1}</span>
            <span>{item}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="container-site mt-12 pb-10">
    <div class="card p-6 text-center">
      <h2 class="text-lg font-semibold text-ink">{t.howItWorks.h1}</h2>
      <p class="mx-auto mt-2 max-w-xl text-sm text-ink-soft">{t.howItWorks.intro}</p>
      <div class="mt-4 flex flex-wrap justify-center gap-3">
        <a href={localizedUrl('/how-it-works/', locale)} class="btn-secondary">{t.nav.howItWorks}</a>
        <a href={localizedUrl('/contact/', locale)} class="btn-primary">{t.common.requestACar}</a>
      </div>
    </div>
  </section>
</BaseLayout>
