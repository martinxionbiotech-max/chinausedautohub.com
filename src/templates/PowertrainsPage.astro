---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getPowertrainsWithVehicles, getVehiclesByPowertrain } from '../lib/data';
import { powertrainUrl } from '../lib/urls';
import { SUBDOMAINS } from '../lib/site';
import { itemListSchema } from '../lib/schema';
import { getTranslations, plural } from '../i18n';
import { powertrainName, powertrainDescription } from '../i18n/reference';
import { DEFAULT_LOCALE, localizedUrl, type Locale } from '../lib/i18n';

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = getTranslations(locale);

const powertrains = getPowertrainsWithVehicles();
const title = t.powertrains.indexTitle;
const description = t.powertrains.indexDescription;

const schema = itemListSchema(
  powertrains.map((p) => ({ name: powertrainName(p.slug, locale, p.name), url: localizedUrl(powertrainUrl(p), locale) })),
);
---

<BaseLayout title={title} description={description} canonical={localizedUrl('/powertrains/', locale)} schema={schema}>
  <Breadcrumb crumbs={[{ name: t.breadcrumb.home, path: localizedUrl('/', locale) }, { name: t.breadcrumb.powertrains, path: localizedUrl('/powertrains/', locale) }]} />

  <section class="container-site py-6">
    <h1 class="text-3xl font-bold text-ink">{t.powertrains.h1}</h1>
    <p class="mt-2 max-w-2xl text-ink-soft">{t.powertrains.intro}</p>
    <p class="mt-3 max-w-2xl text-sm text-ink-muted">
      {t.powertrains.dataNote}{" "}
      <a href={`${SUBDOMAINS.data}/powertrains/`} target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-700 hover:underline">{t.powertrains.dataLink} {t.common.arrow}</a>
    </p>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {powertrains.map((p) => {
        const count = getVehiclesByPowertrain(p.slug).length;
        return (
          <a href={localizedUrl(powertrainUrl(p), locale)} class="card p-5 hover:border-brand-300">
            <h2 class="text-base font-semibold text-ink">{powertrainName(p.slug, locale, p.name)}</h2>
            <p class="mt-1 text-sm text-ink-soft">{powertrainDescription(p.slug, locale, p.description)}</p>
            <p class="mt-2 text-sm text-ink-muted">{plural(locale, 'vehiclesInInventory', count, t)}</p>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>
