---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getAllMarkets } from '../lib/data';
import { SUBDOMAINS } from '../lib/site';
import { getTranslations } from '../i18n';
import { MARKETS_PAGE } from '../i18n/markets';
import { marketName } from '../i18n/reference';
import { pick } from '../i18n/l10n';
import { marketsUrl } from '../lib/urls';
import { DEFAULT_LOCALE, localizedUrl, type Locale } from '../lib/i18n';

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = getTranslations(locale);

const title = pick(MARKETS_PAGE.title, locale);
const description = pick(MARKETS_PAGE.description, locale);
const h1 = pick(MARKETS_PAGE.h1, locale);
const intro = pick(MARKETS_PAGE.intro, locale);

const markets = getAllMarkets();
---

<BaseLayout title={title} description={description} canonical={localizedUrl(marketsUrl(), locale)}>
  <Breadcrumb crumbs={[{ name: t.breadcrumb.home, path: localizedUrl('/', locale) }, { name: t.breadcrumb.markets, path: localizedUrl(marketsUrl(), locale) }]} />

  <section class="container-site py-6">
    <h1 class="text-3xl font-bold text-ink">{h1}</h1>
    <p class="mt-2 max-w-3xl text-ink-soft">{intro}</p>
  </section>

  <section class="container-site">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {markets.map((m) => (
        <a href={m.dataUrl} target="_blank" rel="noopener noreferrer" class="card flex flex-col p-5 hover:border-brand-300">
          <h2 class="text-base font-semibold text-ink">{marketName(m.slug, locale, m.name)}</h2>
          <p class="mt-1 text-sm text-ink-muted">{m.region}</p>
          <span class="mt-3 text-sm font-semibold text-brand-700">{pick(MARKETS_PAGE.detailNote, locale)} {t.common.arrow}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container-site mt-12">
    <div class="grid gap-4 sm:grid-cols-3">
      <a href={localizedUrl('/cars/', locale)} class="card p-5 hover:border-brand-300">
        <h2 class="text-base font-semibold text-ink">{t.nav.availableVehicles}</h2>
        <p class="mt-2 text-sm text-ink-soft">{pick(MARKETS_PAGE.suitableVehicles, locale)}</p>
        <span class="mt-3 inline-block text-sm font-semibold text-brand-700">{t.common.browseCars} {t.common.arrow}</span>
      </a>
      <a href={localizedUrl('/brands/', locale)} class="card p-5 hover:border-brand-300">
        <h2 class="text-base font-semibold text-ink">{t.nav.brands}</h2>
        <p class="mt-2 text-sm text-ink-soft">{pick(MARKETS_PAGE.browseBrands, locale)}</p>
        <span class="mt-3 inline-block text-sm font-semibold text-brand-700">{t.nav.brands} {t.common.arrow}</span>
      </a>
      <a href={SUBDOMAINS.tools} target="_blank" rel="noopener noreferrer" class="card p-5 hover:border-brand-300">
        <h2 class="text-base font-semibold text-ink">{t.nav.tools}</h2>
        <p class="mt-2 text-sm text-ink-soft">{pick(MARKETS_PAGE.importTools, locale)}</p>
        <span class="mt-3 inline-block text-sm font-semibold text-brand-700">{t.nav.tools} {t.common.arrow}</span>
      </a>
    </div>
  </section>

  <section class="container-site mt-12 pb-10">
    <div class="card p-6 text-center">
      <h2 class="text-lg font-semibold text-ink">{t.common.requestACar}</h2>
      <p class="mx-auto mt-2 max-w-xl text-sm text-ink-soft">{t.leadForm.requestSubheading}</p>
      <a href={localizedUrl('/contact/', locale)} class="btn-primary mt-4">{t.common.requestACar}</a>
    </div>
  </section>
</BaseLayout>
