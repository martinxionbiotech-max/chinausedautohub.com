---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import VehicleCard from '../components/VehicleCard.astro';
import {
  getAllVehicles,
  getAllBrands,
  getAllBodyTypes,
  getAllFuelTypes,
  getAllTransmissions,
  getAllDrives,
  getAllModels,
  getMarket,
} from '../lib/data';
import { itemListSchema } from '../lib/schema';
import { vehicleUrl } from '../lib/urls';
import { getTranslations, plural } from '../i18n';
import { bodyTypeName, fuelTypeName, transmissionName, driveName, marketName } from '../i18n/reference';
import { DEFAULT_LOCALE, localizedUrl, type Locale } from '../lib/i18n';
import type { Vehicle } from '../lib/types';

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = getTranslations(locale);

// Server renders every inventory card as crawlable HTML. Client-side JS only
// enhances with live filter/sort/load-more — it never gates the core data.
const all = getAllVehicles();
const availableCount = all.filter((v) => v.status === 'available').length;
const reservedCount = all.filter((v) => v.status === 'reserved').length;
const soldCount = all.filter((v) => v.status === 'sold').length;

const brands = getAllBrands();
const bodyTypes = getAllBodyTypes();
const fuelTypes = getAllFuelTypes();
const transmissions = getAllTransmissions();
const drives = getAllDrives();
const models = getAllModels();

const country = Astro.url.searchParams.get('country') ?? '';
const rawCountryName = country ? (getMarket(country)?.name ?? country) : '';
const countryName = rawCountryName ? marketName(country, locale, rawCountryName) : '';

const title = t.listing.title;
const description = plural(locale, 'vehiclesAvailable', availableCount, t);

const pageSize = 9;
const schema = itemListSchema(
  all.map((v) => ({ name: `${v.year} ${v.brand} ${v.model}`, url: localizedUrl(vehicleUrl(v), locale) })),
);

// Client-side plural forms for the inline filter script.
const clientStrings = {
  locale,
  availableForms: t.plurals.vehiclesAvailable,
  inventoryForms: t.plurals.vehiclesInInventory,
  loadMoreForms: t.plurals.loadMore,
};
---

<BaseLayout title={title} description={description} canonical={localizedUrl('/cars/', locale)} schema={schema}>
  <Breadcrumb crumbs={[{ name: t.breadcrumb.home, path: localizedUrl('/', locale) }, { name: t.breadcrumb.cars, path: localizedUrl('/cars/', locale) }]} />

  <section class="container-site py-6">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h1 class="text-3xl font-bold text-ink">{t.listing.h1}</h1>
        <p class="mt-1 text-ink-soft">
          <span id="listing-count" data-available={availableCount}>{plural(locale, 'vehiclesAvailable', availableCount, t)}</span>
          <span class="text-ink-muted"> · {reservedCount} {t.listing.reserved} · {soldCount} {t.listing.sold}</span>
        </p>
      </div>
      <a href={localizedUrl('/request-a-car/', locale)} class="btn-primary">{t.common.requestACar}</a>
    </div>

    {countryName && (
      <div class="mt-4 rounded-md border border-brand-200 bg-brand-50 p-3 text-sm text-brand-800">
        {t.listing.destinationLabel}: <strong>{countryName}</strong> — {t.listing.destinationNotice}{' '}
        <a href={`${localizedUrl('/request-a-car/', locale)}?country=${country}`} class="font-semibold underline">{t.listing.requestForCountry} {countryName}</a>.
      </div>
    )}

    <!-- FILTER / SORT -->
    <form id="listing-filter" class="mt-6 rounded-lg border border-surface-line bg-surface-alt p-4" onsubmit="return false">
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <label class="block">
          <span class="label !mt-0">{t.listing.search}</span>
          <input id="listing-q" type="text" class="input" placeholder={t.listing.searchPlaceholder} />
        </label>
        <label class="block">
          <span class="label !mt-0">{t.listing.brand}</span>
          <select id="listing-brand" class="input">
            <option value="">{t.listing.anyBrand}</option>
            {brands.map((b) => <option value={b.slug}>{b.name}</option>)}
          </select>
        </label>
        <label class="block">
          <span class="label !mt-0">{t.listing.model}</span>
          <select id="listing-model" class="input">
            <option value="">{t.listing.anyModel}</option>
            {models.map((m) => <option value={m.slug}>{m.name}</option>)}
          </select>
        </label>
        <label class="block">
          <span class="label !mt-0">{t.listing.bodyType}</span>
          <select id="listing-body" class="input">
            <option value="">{t.listing.any}</option>
            {bodyTypes.map((b) => <option value={b.slug}>{bodyTypeName(b.slug, locale, b.name)}</option>)}
          </select>
        </label>
        <label class="block">
          <span class="label !mt-0">{t.listing.fuelType}</span>
          <select id="listing-fuel" class="input">
            <option value="">{t.listing.any}</option>
            {fuelTypes.map((f) => <option value={f.slug}>{fuelTypeName(f.slug, locale, f.name)}</option>)}
          </select>
        </label>
        <label class="block">
          <span class="label !mt-0">{t.listing.transmission}</span>
          <select id="listing-transmission" class="input">
            <option value="">{t.listing.any}</option>
            {transmissions.map((tr) => <option value={tr.slug}>{transmissionName(tr.slug, locale, tr.name)}</option>)}
          </select>
        </label>
        <label class="block">
          <span class="label !mt-0">{t.listing.drive}</span>
          <select id="listing-drive" class="input">
            <option value="">{t.listing.any}</option>
            {drives.map((dr) => <option value={dr.slug}>{driveName(dr.slug, locale, dr.name)}</option>)}
          </select>
        </label>
        <label class="block">
          <span class="label !mt-0">{t.listing.availability}</span>
          <select id="listing-status" class="input">
            <option value="available" selected>{t.status.available}</option>
            <option value="all">{t.listing.allStatuses}</option>
            <option value="reserved">{t.status.reserved}</option>
            <option value="sold">{t.status.sold}</option>
          </select>
        </label>
      </div>

      <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
        <label class="block">
          <span class="label !mt-0">{t.listing.minYear}</span>
          <select id="listing-minyear" class="input">
            <option value="">{t.listing.any}</option>
            <option value="2022">2022</option>
            <option value="2023">2023</option>
            <option value="2024">2024</option>
          </select>
        </label>
        <label class="block">
          <span class="label !mt-0">{t.listing.maxYear}</span>
          <select id="listing-maxyear" class="input">
            <option value="">{t.listing.any}</option>
            <option value="2022">2022</option>
            <option value="2023">2023</option>
            <option value="2024">2024</option>
          </select>
        </label>
        <label class="block">
          <span class="label !mt-0">{t.listing.maxPrice}</span>
          <select id="listing-maxprice" class="input">
            <option value="">{t.listing.any}</option>
            <option value="15000">{t.search.under15000}</option>
            <option value="20000">{t.search.under20000}</option>
            <option value="25000">{t.search.under25000}</option>
            <option value="30000">{t.search.under30000}</option>
          </select>
        </label>
        <label class="block">
          <span class="label !mt-0">{t.listing.maxMileage}</span>
          <select id="listing-maxmileage" class="input">
            <option value="">{t.listing.any}</option>
            <option value="10000">{t.listing.under10000}</option>
            <option value="20000">{t.listing.under20000}</option>
            <option value="30000">{t.listing.under30000}</option>
            <option value="50000">{t.listing.under50000}</option>
          </select>
        </label>
        <label class="block">
          <span class="label !mt-0">{t.listing.sort}</span>
          <select id="listing-sort" class="input">
            <option value="newest">{t.listing.newest}</option>
            <option value="oldest">{t.listing.oldest}</option>
            <option value="price-asc">{t.listing.priceAsc}</option>
            <option value="price-desc">{t.listing.priceDesc}</option>
            <option value="mileage-asc">{t.listing.mileageAsc}</option>
            <option value="mileage-desc">{t.listing.mileageDesc}</option>
          </select>
        </label>
      </div>

      <div class="mt-4 flex items-center justify-between">
        <button type="button" id="listing-clear" class="btn-ghost !px-3 text-sm">{t.listing.clearFilters}</button>
        <p id="listing-empty" class="hidden text-sm text-ink-muted">{t.listing.noMatch}</p>
      </div>
    </form>

    <!-- RESULTS -->
    <div id="listing-grid" class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3" data-page-size={pageSize} data-i18n={JSON.stringify(clientStrings)}>
      {all.map((v: Vehicle) => <VehicleCard vehicle={v} />)}
    </div>

    <div class="mt-8 text-center">
      <button id="listing-more" class="btn-secondary hidden">{t.listing.loadMore}</button>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const grid = document.getElementById('listing-grid');
    if (!grid) return;
    const cards = Array.from(grid.querySelectorAll('[data-vehicle]'));
    const countEl = document.getElementById('listing-count');
    const moreBtn = document.getElementById('listing-more');
    const emptyEl = document.getElementById('listing-empty');
    const pageSize = Number(grid.dataset.pageSize || 9);
    const I18N = (() => { try { return JSON.parse(grid.dataset.i18n || '{}'); } catch { return {}; } })();
    const locale = I18N.locale || 'en';
    let shownCount = pageSize;

    function pluralize(count, forms) {
      if (!forms) return String(count);
      let cat = 'other';
      try { cat = new Intl.PluralRules(locale).select(count); } catch {}
      const tmpl = forms[cat] || forms['other'] || forms['one'] || '{count}';
      return tmpl.replaceAll('{count}', String(count));
    }

    const ids = [
      'q', 'brand', 'model', 'body', 'fuel', 'transmission', 'drive',
      'status', 'minyear', 'maxyear', 'maxprice', 'maxmileage', 'sort',
    ];
    const els = Object.fromEntries(ids.map((k) => [k, document.getElementById('listing-' + k)]));

    const params = new URLSearchParams(location.search);
    if (els.brand && params.get('brand')) els.brand.value = params.get('brand');
    if (els.q && params.get('q')) els.q.value = params.get('q');
    if (els.maxprice && params.get('maxPrice')) els.maxprice.value = params.get('maxPrice');
    if (els.minyear && params.get('minYear')) els.minyear.value = params.get('minYear');

    function val(id) { return els[id] ? els[id].value : ''; }

    function matches(card) {
      const d = card.dataset;
      const q = val('q').toLowerCase();
      if (q) {
        const hay = `${d.brand} ${d.model} ${d.year} ${d.color ?? ''}`.toLowerCase();
        if (!hay.includes(q)) return false;
      }
      if (val('brand') && d.brand !== val('brand')) return false;
      if (val('model') && d.model !== val('model')) return false;
      if (val('body') && d.body !== val('body')) return false;
      if (val('fuel') && d.fuel !== val('fuel')) return false;
      if (val('transmission') && d.transmission !== val('transmission')) return false;
      if (val('drive') && d.drive !== val('drive')) return false;

      const status = val('status') || 'available';
      if (status !== 'all' && d.status !== status) return false;

      const year = Number(d.year);
      if (val('minyear') && year < Number(val('minyear'))) return false;
      if (val('maxyear') && year > Number(val('maxyear'))) return false;
      const price = Number(d.price);
      if (val('maxprice') && price > Number(val('maxprice'))) return false;
      const mileage = Number(d.mileage);
      if (val('maxmileage') && mileage > Number(val('maxmileage'))) return false;
      return true;
    }

    function sortCmp(a, b) {
      const sort = val('sort') || 'newest';
      const da = a.dataset, db = b.dataset;
      switch (sort) {
        case 'price-asc': return Number(da.price) - Number(db.price);
        case 'price-desc': return Number(db.price) - Number(da.price);
        case 'oldest': return Number(da.year) - Number(db.year);
        case 'mileage-asc': return Number(da.mileage) - Number(db.mileage);
        case 'mileage-desc': return Number(db.mileage) - Number(da.mileage);
        default: return Number(db.year) - Number(da.year);
      }
    }

    function apply() {
      const visible = cards.filter(matches).sort(sortCmp);
      const hidden = cards.filter((c) => !matches(c));

      visible.forEach((c) => grid.appendChild(c));
      hidden.forEach((c) => grid.appendChild(c));

      visible.forEach((c) => c.classList.remove('listing-hidden', 'hidden'));
      hidden.forEach((c) => c.classList.add('hidden'));

      visible.forEach((c, i) => {
        if (i < shownCount) c.classList.remove('listing-hidden');
        else c.classList.add('listing-hidden');
      });

      const status = val('status') || 'available';
      const forms = status === 'all' ? I18N.inventoryForms : I18N.availableForms;
      countEl.textContent = pluralize(visible.length, forms);

      const remaining = visible.length - shownCount;
      if (remaining > 0) {
        moreBtn.classList.remove('hidden');
        moreBtn.textContent = pluralize(remaining, I18N.loadMoreForms);
      } else {
        moreBtn.classList.add('hidden');
      }
      emptyEl.classList.toggle('hidden', visible.length !== 0);
    }

    ids.forEach((k) => { if (els[k]) els[k].addEventListener('input', () => { shownCount = pageSize; apply(); }); });

    document.getElementById('listing-clear')?.addEventListener('click', () => {
      ids.forEach((k) => { if (els[k] && els[k].tagName === 'SELECT') els[k].selectedIndex = 0; else if (els[k]) els[k].value = ''; });
      if (els.status) els.status.value = 'available';
      shownCount = pageSize;
      apply();
    });

    moreBtn?.addEventListener('click', () => { shownCount += pageSize; apply(); });

    apply();
  })();
</script>
