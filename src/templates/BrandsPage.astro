---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getBrandsWithVehicles, getVehiclesByBrand } from '../lib/data';
import { brandUrl } from '../lib/urls';
import { itemListSchema } from '../lib/schema';
import { getTranslations, plural } from '../i18n';
import { DEFAULT_LOCALE, localizedUrl, type Locale } from '../lib/i18n';

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = getTranslations(locale);

const brands = getBrandsWithVehicles();
const title = t.brands.indexTitle;
const description = t.brands.indexDescription;

const schema = itemListSchema(brands.map((b) => ({ name: b.name, url: localizedUrl(brandUrl(b), locale) })));
---

<BaseLayout title={title} description={description} canonical={localizedUrl('/brands/', locale)} schema={schema}>
  <Breadcrumb crumbs={[{ name: t.breadcrumb.home, path: localizedUrl('/', locale) }, { name: t.breadcrumb.brands, path: localizedUrl('/brands/', locale) }]} />

  <section class="container-site py-6">
    <h1 class="text-3xl font-bold text-ink">{t.brands.h1}</h1>
    <p class="mt-2 max-w-2xl text-ink-soft">
      {t.brands.intro}
    </p>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {brands.map((b) => {
        const count = getVehiclesByBrand(b.slug).length;
        return (
          <a href={localizedUrl(brandUrl(b), locale)} class="card p-5 hover:border-brand-300">
            <span class="flex h-11 w-11 items-center justify-center rounded bg-brand-800 text-sm font-bold text-white">{b.name.slice(0, 2).toUpperCase()}</span>
            <h2 class="mt-3 text-base font-semibold text-ink">{b.name}</h2>
            <p class="mt-1 text-sm text-ink-muted">{plural(locale, 'vehiclesAvailable', count, t)}</p>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>
