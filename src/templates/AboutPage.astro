---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { CONTACT } from '../lib/site';
import { getTranslations } from '../i18n';
import { ABOUT_PAGE } from '../i18n/about';
import { pick } from '../i18n/l10n';
import { DEFAULT_LOCALE, localizedUrl, type Locale } from '../lib/i18n';

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = getTranslations(locale);

const title = pick(ABOUT_PAGE.title, locale);
const description = pick(ABOUT_PAGE.description, locale);
const h1 = pick(ABOUT_PAGE.h1, locale);
const intro = pick(ABOUT_PAGE.intro, locale);
---

<BaseLayout title={title} description={description} canonical={localizedUrl('/about/', locale)}>
  <Breadcrumb crumbs={[{ name: t.breadcrumb.home, path: localizedUrl('/', locale) }, { name: t.breadcrumb.about, path: localizedUrl('/about/', locale) }]} />

  <section class="container-site py-6">
    <h1 class="text-3xl font-bold text-ink">{h1}</h1>
    <p class="mt-3 max-w-3xl text-ink-soft">{intro}</p>
  </section>

  <section class="container-site mt-6 max-w-3xl">
    <div class="space-y-8">
      {ABOUT_PAGE.sections.map((section) => (
        <section>
          <h2 class="text-xl font-bold text-ink">{pick(section.heading, locale)}</h2>
          <div class="prose-vehicle mt-3 space-y-3">
            {section.paragraphs.map((p) => <p>{pick(p, locale)}</p>)}
          </div>
        </section>
      ))}
    </div>
  </section>

  <section class="container-site mt-12 max-w-3xl">
    <h2 class="text-xl font-bold text-ink">{pick(ABOUT_PAGE.distinctionHeading, locale)}</h2>
    <p class="mt-2 text-ink-soft">{pick(ABOUT_PAGE.distinctionIntro, locale)}</p>
    <div class="mt-5 grid gap-4 sm:grid-cols-3">
      {ABOUT_PAGE.distinctions.map((d) => (
        <div class="card p-5">
          <h3 class="text-base font-semibold text-ink">{pick(d.heading, locale)}</h3>
          <p class="mt-2 text-sm text-ink-soft">{pick(d.text, locale)}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-site mt-12 pb-10">
    <div class="card max-w-3xl p-6">
      <h2 class="text-lg font-semibold text-ink">{t.about.contactHeading}</h2>
      <div class="mt-3 space-y-2 text-sm text-ink-soft">
        <p>{t.footer.email}: <a href={`mailto:${CONTACT.email}`} class="font-semibold text-brand-700 hover:underline">{CONTACT.email}</a></p>
        <p>{t.footer.whatsapp}: <a href={CONTACT.whatsappLink} target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-700 hover:underline">{CONTACT.whatsapp}</a></p>
      </div>
      <a href={localizedUrl('/contact/', locale)} class="btn-primary mt-4">{t.about.contactUs}</a>
    </div>
  </section>
</BaseLayout>
