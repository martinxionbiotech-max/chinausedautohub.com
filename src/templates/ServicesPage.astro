---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { itemListSchema } from '../lib/schema';
import { getTranslations } from '../i18n';
import { SERVICES, SERVICES_OVERVIEW } from '../i18n/services';
import { pick } from '../i18n/l10n';
import { serviceUrl, servicesUrl } from '../lib/urls';
import { DEFAULT_LOCALE, localizedUrl, type Locale } from '../lib/i18n';

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = getTranslations(locale);

const title = pick(SERVICES_OVERVIEW.title, locale);
const description = pick(SERVICES_OVERVIEW.description, locale);
const h1 = pick(SERVICES_OVERVIEW.h1, locale);
const intro = pick(SERVICES_OVERVIEW.intro, locale);

const schema = itemListSchema(
  SERVICES.map((s) => ({ name: pick(s.h1, locale), url: localizedUrl(serviceUrl(s.slug), locale) })),
);

const SERVICE_IMAGES: Record<string, string> = {
  'vehicle-sourcing': 'service-sourcing-800x533',
  'vehicle-inspection': 'service-inspection-800x533',
  'export-documentation': 'service-documentation-800x533',
  'shipping': 'service-shipping-800x533',
  'port-handling': 'service-port-handling-800x533',
};
---

<BaseLayout title={title} description={description} canonical={localizedUrl(servicesUrl(), locale)} schema={schema}>
  <Breadcrumb crumbs={[{ name: t.breadcrumb.home, path: localizedUrl('/', locale) }, { name: t.breadcrumb.services, path: localizedUrl(servicesUrl(), locale) }]} />

  <section class="container-site py-6">
    <h1 class="text-3xl font-bold text-ink">{h1}</h1>
    <p class="mt-2 max-w-3xl text-ink-soft">{intro}</p>
  </section>

  <section class="container-site">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {SERVICES.map((s) => (
        <a href={localizedUrl(serviceUrl(s.slug), locale)} class="card flex flex-col overflow-hidden p-0 hover:border-brand-300">
          <img
            src={`/images/${SERVICE_IMAGES[s.slug] ?? 'og-default-1200x630'}.webp`}
            alt={pick(s.h1, locale)}
            width="800"
            height="533"
            loading="lazy"
            decoding="async"
            class="aspect-[800/533] w-full object-cover"
          />
          <div class="flex flex-col p-5">
            <h2 class="text-base font-semibold text-ink">{pick(s.h1, locale)}</h2>
            <p class="mt-2 flex-1 text-sm text-ink-soft">{pick(s.summary, locale)}</p>
            <span class="mt-3 text-sm font-semibold text-brand-700">{t.common.viewDetails} {t.common.arrow}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="container-site mt-12 pb-10">
    <div class="card p-6 text-center">
      <h2 class="text-lg font-semibold text-ink">{t.howItWorks.h1}</h2>
      <p class="mx-auto mt-2 max-w-xl text-sm text-ink-soft">{t.howItWorks.intro}</p>
      <div class="mt-4 flex flex-wrap justify-center gap-3">
        <a href={localizedUrl('/how-it-works/', locale)} class="btn-secondary">{t.nav.howItWorks}</a>
        <a href={localizedUrl('/contact/', locale)} class="btn-primary">{t.common.requestACar}</a>
      </div>
    </div>
  </section>
</BaseLayout>
