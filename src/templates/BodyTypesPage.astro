---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getBodyTypesWithVehicles, getVehiclesByBodyType } from '../lib/data';
import { bodyTypeUrl } from '../lib/urls';
import { itemListSchema } from '../lib/schema';
import { getTranslations, plural } from '../i18n';
import { bodyTypeName, bodyTypeDescription } from '../i18n/reference';
import { DEFAULT_LOCALE, localizedUrl, type Locale } from '../lib/i18n';

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = getTranslations(locale);

const bodyTypes = getBodyTypesWithVehicles();
const title = t.bodyTypes.indexTitle;
const description = t.bodyTypes.indexDescription;

const schema = itemListSchema(bodyTypes.map((bt) => ({ name: bodyTypeName(bt.slug, locale, bt.name), url: localizedUrl(bodyTypeUrl(bt), locale) })));
---

<BaseLayout title={title} description={description} canonical={localizedUrl('/body-types/', locale)} schema={schema}>
  <Breadcrumb crumbs={[{ name: t.breadcrumb.home, path: localizedUrl('/', locale) }, { name: t.breadcrumb.vehicleTypes, path: localizedUrl('/body-types/', locale) }]} />

  <section class="container-site py-6">
    <h1 class="text-3xl font-bold text-ink">{t.bodyTypes.h1}</h1>
    <p class="mt-2 max-w-2xl text-ink-soft">{t.bodyTypes.intro}</p>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {bodyTypes.map((bt) => {
        const count = getVehiclesByBodyType(bt.slug).length;
        return (
          <a href={localizedUrl(bodyTypeUrl(bt), locale)} class="card p-5 hover:border-brand-300">
            <h2 class="text-base font-semibold text-ink">{bodyTypeName(bt.slug, locale, bt.name)}</h2>
            <p class="mt-1 text-sm text-ink-soft">{bodyTypeDescription(bt.slug, locale, bt.description)}</p>
            <p class="mt-2 text-sm text-ink-muted">{plural(locale, 'vehiclesInInventory', count, t)}</p>
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>
