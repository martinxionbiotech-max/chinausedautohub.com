---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import LeadForm from '../components/LeadForm.astro';
import { getTranslations } from '../i18n';
import { DEFAULT_LOCALE, localizedUrl, type Locale } from '../lib/i18n';

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = getTranslations(locale);
---

<BaseLayout title={t.leadForm.requestHeading} description={t.leadForm.requestSubheading} canonical={localizedUrl('/request-a-car/', locale)}>
  <Breadcrumb crumbs={[{ name: t.breadcrumb.home, path: localizedUrl('/', locale) }, { name: t.breadcrumb.requestACar, path: localizedUrl('/request-a-car/', locale) }]} />

  <section class="container-site py-6">
    <h1 class="text-3xl font-bold text-ink">{t.leadForm.requestHeading}</h1>
    <p class="mt-2 max-w-2xl text-ink-soft">
      {t.leadForm.requestSubheading}
    </p>
    <p class="mt-2 max-w-2xl text-sm text-ink-muted">
      {t.home.ctaDetail}
    </p>
  </section>

  <section class="container-site pb-10">
    <div class="max-w-3xl">
      <LeadForm variant="full" />
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // Prefill destination from ?country= (e.g. hero search → request a car).
  const params = new URLSearchParams(location.search);
  const country = params.get('country');
  if (country) {
    const el = document.getElementById('request-car-form-country');
    if (el) el.value = country;
  }
</script>
