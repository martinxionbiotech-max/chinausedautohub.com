---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import VehicleCard from '../components/VehicleCard.astro';
import {
  getBrand,
  getVehiclesByBrand,
  getPopularModelsForBrand,
  getModelsByBrand,
  getBodyType,
  getPowertrain,
} from '../lib/data';
import { SITE } from '../lib/site';
import { dataBrandUrl, dataModelUrl, brandUrl, powertrainUrl, toolUrl, guideUrl, type ToolSlug } from '../lib/urls';
import { itemListSchema } from '../lib/schema';
import { getTranslations } from '../i18n';
import { GUIDES } from '../i18n/guides';
import { pick } from '../i18n/l10n';
import { getBrandKnowledge } from '../i18n/brands';
import { getBrandDetail } from '../i18n/brands-detail';
import { bodyTypeName, brandOverview, modelDescription, powertrainName } from '../i18n/reference';
import { DEFAULT_LOCALE, localizedUrl, type Locale } from '../lib/i18n';
import type { Vehicle } from '../lib/types';

interface Props {
  brand: string;
}

const { brand: brandSlug } = Astro.props;
const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = getTranslations(locale);

const brand = getBrand(brandSlug);
if (!brand) {
  return Astro.redirect(localizedUrl('/brands/', locale));
}

const vehicles = getVehiclesByBrand(brandSlug);
const available = vehicles.filter((v) => v.status === 'available');
const popularModels = getPopularModelsForBrand(brandSlug);
const allModels = getModelsByBrand(brandSlug);

const relatedTools: { slug: ToolSlug; label: string }[] = [
  { slug: 'landed-cost-calculator', label: t.tools.landedCost },
  { slug: 'import-duty-calculator', label: t.tools.importDuty },
  { slug: 'shipping-cost-estimator', label: t.tools.shippingCost },
  { slug: 'profit-calculator', label: t.tools.profit },
];

const relatedGuideSlugs = [
  'how-to-buy-used-car-from-china',
  'china-used-car-export-process',
  'vehicle-inspection',
  'landed-cost',
];
const relatedGuides = GUIDES.filter((g) => relatedGuideSlugs.includes(g.slug));

const typeSlugs = Array.from(new Set(vehicles.map((v) => v.body_type)));
const vehicleTypes = typeSlugs.map((s) => getBodyType(s)).filter(Boolean);

const fuelSlugs = Array.from(new Set(vehicles.map((v) => v.fuel)));
const powertrainOptions = fuelSlugs.map((s) => getPowertrain(s)).filter(Boolean);

const knowledge = getBrandKnowledge(brandSlug, locale);
const detail = getBrandDetail(brandSlug, locale);

// Per-brand model families derived from the data layer (never invented).
const detailRows: { label: string; value: string }[] = [
  { label: t.brands.majorSegments, value: detail.majorSegments },
  { label: t.brands.exportModels, value: detail.exportModels },
  { label: t.brands.portfolio, value: detail.portfolio },
  { label: t.brands.usedMarket, value: detail.usedMarket },
  { label: t.brands.modelFamilies, value: detail.modelFamilies },
  { label: t.brands.destinationConsiderations, value: detail.destinationConsiderations },
];

const title = `${brand.name} — ${t.brands.vehiclesForExport}`;
const description = `${t.listing.descriptionPrefix} ${available.length} ${t.listing.available} ${brand.name} — ${t.brands.vehiclesForExport}.`;

const schema = itemListSchema(available.map((v) => ({ name: `${v.year} ${brand.name} ${v.model}`, url: localizedUrl(`/cars/${v.brand}/${v.model}/${v.vehicle_id}/`, locale) })));

const overview = brandOverview(brand.slug, locale, brand.overview);
const requestBrandHref = localizedUrl('/contact/', locale);
---

<BaseLayout title={title} description={description} canonical={localizedUrl(brandUrl(brand), locale)} schema={schema}>
  <Breadcrumb crumbs={[{ name: t.breadcrumb.home, path: localizedUrl('/', locale) }, { name: t.breadcrumb.brands, path: localizedUrl('/brands/', locale) }, { name: brand.name, path: localizedUrl(brandUrl(brand), locale) }]} />

  <!-- BRAND BANNER -->
  <section class="container-site pt-6">
    <img
      src="/images/brand-banner-1200x400.webp"
      alt=""
      width="1200"
      height="400"
      loading="lazy"
      decoding="async"
      class="w-full rounded-lg object-cover"
    />
  </section>

  <!-- BRAND OVERVIEW -->
  <section class="container-site py-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-3xl font-bold text-ink">{brand.name} {t.brands.vehiclesForExport}</h1>
        <p class="mt-3 max-w-3xl text-ink-soft">{overview}</p>
      </div>
      <a href={requestBrandHref} class="btn-primary">{t.brands.requestBrand}</a>
    </div>
  </section>

  <!-- WHY CONSIDER -->
  <section class="container-site">
    <div class="card p-6">
      <h2 class="text-xl font-bold text-ink">{t.brands.whyConsider}</h2>
      <p class="mt-2 max-w-3xl text-ink-soft">{knowledge.whyConsider}</p>
    </div>
  </section>

  <!-- AVAILABLE VEHICLES -->
  <section class="container-site mt-12">
    <h2 class="text-xl font-bold text-ink">{t.brands.availableVehicles}</h2>
    {available.length > 0 ? (
      <div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {available.map((v: Vehicle) => <VehicleCard vehicle={v} />)}
      </div>
    ) : (
      <p class="mt-3 text-ink-soft">{brand.name} {t.brands.noAvailable} <a href={requestBrandHref} class="font-semibold text-brand-700">{t.brands.requestBrand}</a> {t.brands.requestAndSource}</p>
    )}
  </section>

  <!-- MODEL DIRECTORY -->
  {allModels.length > 0 && (
    <section class="container-site mt-12">
      <h2 class="text-xl font-bold text-ink">{t.brands.modelDirectory}</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {allModels.map((m) => {
          const mUrl = dataModelUrl(m);
          return (
            <div class="card p-4">
              <span class="block text-base font-semibold text-ink">{m.name}</span>
              <span class="block text-sm text-ink-muted">{modelDescription(m.brand, m.slug, locale, m.shortDescription)}</span>
              {mUrl && (
                <a href={mUrl} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-sm font-semibold text-brand-700 hover:underline">{t.common.viewSpecifications} {t.common.arrow}</a>
              )}
            </div>
          );
        })}
      </div>
    </section>
  )}

  <!-- VEHICLE TYPES -->
  {vehicleTypes.length > 0 && (
    <section class="container-site mt-12">
      <h2 class="text-xl font-bold text-ink">{t.brands.vehicleTypes}</h2>
      <div class="mt-4 flex flex-wrap gap-3">
        {vehicleTypes.map((bt) => (
          <a href={localizedUrl(`/body-types/${bt.slug}/`, locale)} class="card px-4 py-2.5 text-sm font-medium text-ink hover:border-brand-300">{bodyTypeName(bt.slug, locale, bt.name)}</a>
        ))}
      </div>
    </section>
  )}

  <!-- POWERTRAIN OPTIONS -->
  {powertrainOptions.length > 0 && (
    <section class="container-site mt-12">
      <h2 class="text-xl font-bold text-ink">{t.brands.powertrainOptions}</h2>
      <div class="mt-4 flex flex-wrap gap-3">
        {powertrainOptions.map((p) => (
          <a href={localizedUrl(powertrainUrl(p), locale)} class="card px-4 py-2.5 text-sm font-medium text-ink hover:border-brand-300">{powertrainName(p.slug, locale, p.name)}</a>
        ))}
      </div>
    </section>
  )}

  <!-- CHINA MARKET POSITION + EXPORT CONSIDERATIONS -->
  <section class="container-site mt-12">
    <div class="grid gap-5 lg:grid-cols-2">
      <div class="card p-6">
        <h2 class="text-lg font-semibold text-ink">{t.brands.chinaPosition}</h2>
        <p class="mt-2 text-sm text-ink-soft">{knowledge.chinaPosition}</p>
      </div>
      <div class="card p-6">
        <h2 class="text-lg font-semibold text-ink">{t.brands.exportConsideration}</h2>
        <p class="mt-2 text-sm text-ink-soft">{knowledge.exportConsideration}</p>
      </div>
    </div>
  </section>

  <!-- PROCUREMENT-DETAIL SECTIONS (PHASE 5) -->
  <section class="container-site mt-12">
    <h2 class="text-xl font-bold text-ink">{t.brands.whyConsider}</h2>
    <div class="mt-4 grid gap-5 lg:grid-cols-2">
      {detailRows.map((r) => (
        <div class="card p-6">
          <h3 class="text-base font-semibold text-ink">{r.label}</h3>
          <p class="mt-2 text-sm text-ink-soft">{r.value}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- POPULAR DESTINATION MARKETS -->
  <section class="container-site mt-12">
    <h2 class="text-xl font-bold text-ink">{t.brands.destinationMarkets}</h2>
    <p class="mt-1 text-sm text-ink-muted">{t.brands.marketNote}</p>
    <div class="mt-4 flex flex-wrap gap-3">
      {t.home.markets.map((m) => (
        <a href={`${SITE.subdomains.market}/countries/${m.slug}/`} target="_blank" rel="noopener noreferrer" class="card px-4 py-2.5 text-sm font-medium text-ink hover:border-brand-300">{m.name}</a>
      ))}
    </div>
  </section>

  <!-- RELATED VEHICLE DATA -->
  <section class="container-site mt-12">
    <h2 class="text-xl font-bold text-ink">{t.brands.relatedData}</h2>
    <div class="mt-4 grid gap-5 lg:grid-cols-2">
      <a href={dataBrandUrl(brand)} target="_blank" rel="noopener noreferrer" class="card p-5 hover:border-brand-300">
        <span class="block text-lg font-semibold text-ink">{brand.name} {t.brands.data}</span>
        <p class="mt-2 text-sm text-ink-soft">{t.brands.dataDesc}</p>
        <span class="mt-2 block text-sm font-semibold text-brand-700">{t.brands.dataSubsite} {t.common.arrow}</span>
      </a>
      {popularModels.length > 0 && (
        <div class="card p-5">
          <span class="block text-lg font-semibold text-ink">{t.brands.popularModels}</span>
          <div class="mt-3 flex flex-wrap gap-2">
            {popularModels.map((m) => {
              const mUrl = dataModelUrl(m);
              return mUrl ? (
                <a href={mUrl} target="_blank" rel="noopener noreferrer" class="rounded-md border border-surface-line px-3 py-1.5 text-sm text-ink hover:border-brand-300">{m.name}</a>
              ) : (
                <span class="rounded-md border border-surface-line px-3 py-1.5 text-sm text-ink-muted">{m.name}</span>
              );
            })}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- RELATED GUIDES -->
  <section class="container-site mt-12">
    <h2 class="text-xl font-bold text-ink">{t.brands.relatedGuides}</h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {relatedGuides.map((g) => (
        <a href={localizedUrl(guideUrl(g.slug), locale)} class="card p-4 hover:border-brand-300">
          <span class="block text-sm font-semibold text-ink">{pick(g.title, locale)}</span>
          <span class="mt-1 block text-xs text-ink-muted">{t.nav.guides}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- RELATED TOOLS -->
  <section class="container-site mt-12">
    <h2 class="text-xl font-bold text-ink">{t.tools.relatedTools}</h2>
    <p class="mt-1 text-sm text-ink-muted">{t.tools.intro}</p>
    <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {relatedTools.map((tool) => (
        <a href={toolUrl(tool.slug)} target="_blank" rel="noopener noreferrer" class="card p-4 hover:border-brand-300">
          <span class="block text-sm font-semibold text-ink">{tool.label}</span>
          <span class="mt-1 block text-xs text-ink-muted">{t.nav.tools}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- REQUEST THIS BRAND -->
  <section class="container-site mt-12">
    <div class="rounded-xl bg-brand-900 p-8 text-white">
      <h2 class="text-2xl font-bold">{t.brands.requestBrand}: {brand.name}</h2>
      <p class="mt-2 max-w-2xl text-brand-100">{t.home.ctaDetail}</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href={requestBrandHref} class="btn-primary">{t.brands.requestBrand}</a>
        <a href={localizedUrl('/cars/', locale)} class="btn-secondary !border-white/30 !bg-transparent !text-white hover:!bg-white/10">{t.common.browseCars}</a>
      </div>
    </div>
  </section>
</BaseLayout>
