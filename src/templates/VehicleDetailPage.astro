---
import BaseLayout from '../components/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import VehicleCard from '../components/VehicleCard.astro';
import LeadForm from '../components/LeadForm.astro';
import { getSimilarVehicles, resolveVehicle, vehicleTitle } from '../lib/data';
import { SITE, formatPrice, formatMileage, formatDate, CONTACT } from '../lib/site';
import { dataModelUrl, dataBrandUrl, vehicleUrl, toolUrl, guideUrl } from '../lib/urls';
import { vehicleSchema, breadcrumbSchema, type FaqItem } from '../lib/schema';
import { getTranslations } from '../i18n';
import { GUIDES } from '../i18n/guides';
import { pick } from '../i18n/l10n';
import {
  vehicleDescription,
} from '../i18n/vehicles';
import {
  fuelTypeName,
  transmissionName,
  driveName,
  bodyTypeName,
  colorName,
  locationName,
  modelDescription,
} from '../i18n/reference';
import { DEFAULT_LOCALE, localizedUrl, type Locale } from '../lib/i18n';
import type { Vehicle } from '../lib/types';

interface Props {
  vehicle: Vehicle;
}

const { vehicle } = Astro.props;
const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const t = getTranslations(locale);

const d = resolveVehicle(vehicle);
const title = vehicleTitle(d);
const isSold = vehicle.status === 'sold';
const isReserved = vehicle.status === 'reserved';
const isBatteryVehicle = vehicle.fuel === 'ev' || vehicle.fuel === 'phev';

const similar = getSimilarVehicles(vehicle, 4);

const statusLabel = t.status[vehicle.status] ?? vehicle.status;

const brandName = d.brand?.name ?? vehicle.brand;
const modelName = d.model?.name ?? vehicle.model;
const fuel = fuelTypeName(vehicle.fuel, locale, d.fuelType?.name ?? vehicle.fuel);
const trans = transmissionName(vehicle.transmission, locale, d.transmission?.name ?? vehicle.transmission);
const drive = driveName(vehicle.drive, locale, d.drive?.name ?? vehicle.drive);
const color = colorName(vehicle.color, locale);
const location = locationName(vehicle.location, locale);
const desc = vehicleDescription(vehicle.vehicle_id, locale, vehicle.description);
const modelDataUrl = d.model ? dataModelUrl(d.model) : null;

const relatedGuideSlugs = [
  'how-to-buy-used-car-from-china',
  'china-used-car-export-process',
  'vehicle-inspection',
  'landed-cost',
  'shipping',
  ...(vehicle.fuel === 'ev' || vehicle.fuel === 'phev' ? ['buying-chinese-evs-for-export'] : []),
];
const relatedGuides = GUIDES.filter((g) => relatedGuideSlugs.includes(g.slug));

const pageTitle = `${vehicle.is_demo ? `${t.detail.demoTitlePrefix} ` : ''}${title} — ${formatPrice(vehicle.price, locale)} | ${t.detail.titleSuffix}`;
const statusText = vehicle.status === 'available' ? t.detail.statusAvailable : `${t.detail.statusPrefix}: ${statusLabel}`;
const description = `${vehicle.year} ${brandName} ${modelName}, ${formatMileage(vehicle.mileage_km, locale, t.units.km)}, ${fuel}, ${color}, ${location}. ${statusText}.`;

const whatsappHref = `${CONTACT.whatsappLink}?text=${encodeURIComponent(`${t.detail.requestQuote}: ${title}`)}`;

const crumbs = [
  { name: t.breadcrumb.home, path: localizedUrl('/', locale) },
  { name: t.breadcrumb.cars, path: localizedUrl('/cars/', locale) },
  { name: brandName, path: localizedUrl(`/brands/${vehicle.brand}/`, locale) },
  { name: title, path: localizedUrl(vehicleUrl(vehicle), locale) },
];

const specLabelMap: Record<string, string> = {
  Engine: t.specLabels.engine,
  Battery: t.specLabels.battery,
  Power: t.specLabels.power,
  Seats: t.specLabels.seats,
  Doors: t.specLabels.doors,
  Drivetrain: t.specLabels.drivetrain,
  Transmission: t.specLabels.transmission,
  Architecture: t.specLabels.architecture,
  'Emission standard': t.specLabels.emissionStandard,
};
const specLabel = (label: string) => specLabelMap[label] ?? label;

const conditionLabelMap: Record<string, string> = {
  exterior: t.conditionLabels.exterior,
  interior: t.conditionLabels.interior,
  engine: t.conditionLabels.engine,
  transmission: t.conditionLabels.transmission,
  chassis: t.conditionLabels.chassis,
  electrical: t.conditionLabels.electrical,
  tires: t.conditionLabels.tires,
  paint: t.conditionLabels.paint,
};

const exportLabelMap: Record<string, string> = {
  export_availability: t.exportLabels.export_availability,
  pickup_location: t.exportLabels.pickup_location,
  shipping_port: t.exportLabels.shipping_port,
  inspection: t.exportLabels.inspection,
  documents: t.exportLabels.documents,
};

const faqs: FaqItem[] = [];
if (isSold) {
  faqs.push({ question: t.detail.faqSold, answer: t.detail.faqSoldAnswer });
} else {
  faqs.push({ question: t.detail.faqAvailable, answer: `${t.detail.faqAvailableYes} ${statusLabel}. ${t.detail.faqAvailableYesTail}` });
}
faqs.push({ question: t.detail.faqExport, answer: t.detail.faqExportAnswer });
faqs.push({ question: t.detail.faqPrice, answer: t.detail.faqPriceAnswer });
if (vehicle.is_demo) {
  faqs.push({ question: t.detail.faqDemo, answer: t.detail.faqDemoAnswer });
}

const schemas = [vehicleSchema(vehicle, locale), breadcrumbSchema(crumbs)];

const aboutModelHeading = t.detail.aboutModel.replace('{model}', modelName);
const viewModelSpecsText = t.detail.viewModelSpecs.replace('{model}', modelName);

const verificationLevelLabels: Record<string, string> = {
  provided: t.confidence.provided,
  verified: t.confidence.verified,
  seller_supplied: t.confidence.sellerSupplied,
  source_backed: t.confidence.sourceBacked,
  not_available: t.confidence.notAvailable,
  not_independently_verified: t.confidence.notIndependentlyVerified,
};

const verificationFields = [
  { key: 'mileage', label: t.confidence.mileageVerified },
  { key: 'vehicle_identity', label: t.confidence.vehicleIdentityVerified },
  { key: 'photos', label: t.confidence.photosAvailable },
  { key: 'inspection', label: t.confidence.inspectionAvailable },
  { key: 'battery_report', label: t.confidence.batteryReportAvailable },
  { key: 'service_history', label: t.confidence.serviceHistoryAvailable },
  { key: 'documents', label: t.confidence.documentsAvailable },
  { key: 'vin', label: t.confidence.vinAvailable },
  { key: 'export_eligibility', label: t.confidence.exportEligibilityChecked },
];

const verificationRows = verificationFields.map((f) => {
  const level = vehicle.verification?.[f.key] ?? 'not_available';
  return { label: f.label, level: verificationLevelLabels[level] ?? level };
});

const verificationAvailableCount = verificationFields.filter(
  (f) => (vehicle.verification?.[f.key] ?? 'not_available') !== 'not_available',
).length;
const verificationTotalCount = verificationFields.length;
const sourceLabel = vehicle.data_source ?? vehicle.source;
const dataAvailabilityText = t.confidence.dataAvailabilitySummary
  .replace('{count}', String(verificationAvailableCount))
  .replace('{total}', String(verificationTotalCount));

const lastVerifiedText = vehicle.last_verified_at
  ? formatDate(vehicle.last_verified_at, locale)
  : t.confidence.notAvailable;

const batteryCapacityValue =
  vehicle.battery_capacity ??
  vehicle.specs.find((s) => s.label === 'Battery')?.value ??
  null;
const batteryHealthValue = vehicle.battery_health ?? null;
const batteryStatusValue = vehicle.battery_status ?? null;
const accidentValue = vehicle.accident_history ?? null;
const maintenanceValue = vehicle.maintenance_history ?? null;
const inspectionValue = vehicle.inspection_status ?? null;
const documentsValue = vehicle.documents ?? null;
const vinStatusValue = vehicle.vin ?? t.detail.notCurrentlyAvailable;
const historyStatusValue =
  vehicle.accident_history || vehicle.maintenance_history
    ? t.status.available
    : t.detail.notCurrentlyAvailable;
---

<BaseLayout title={pageTitle} description={description} canonical={localizedUrl(vehicleUrl(vehicle), locale)} schema={schemas} noindex={vehicle.is_demo}>
  <Breadcrumb crumbs={crumbs} />

  {vehicle.is_demo && (
    <div class="container-site pt-4">
      <div class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3">
        <p class="text-sm font-semibold text-amber-800">{t.detail.demoBanner}</p>
      </div>
    </div>
  )}

  <!-- VEHICLE ENTITY CHAIN: Brand → Model → Generation → Trim → Vehicle -->
  <div class="container-site pt-2">
    <nav aria-label={t.detail.entityChain} class="flex flex-wrap items-center gap-1.5 text-sm text-ink-muted">
      <span class="font-semibold text-ink-soft">{t.detail.entityChain}:</span>
      <a href={dataBrandUrl({ slug: vehicle.brand })} target="_blank" rel="noopener noreferrer" class="font-medium text-brand-700 hover:underline">{brandName}</a>
      <span aria-hidden="true">{t.common.arrow}</span>
      {modelDataUrl ? (
        <a href={modelDataUrl} target="_blank" rel="noopener noreferrer" class="font-medium text-brand-700 hover:underline">{modelName}</a>
      ) : (
        <span class="text-ink-soft">{modelName}</span>
      )}
      {vehicle.generation && (<><span aria-hidden="true">{t.common.arrow}</span><span class="text-ink-soft">{vehicle.generation}</span></>)}
      {vehicle.trim && (<><span aria-hidden="true">{t.common.arrow}</span><span class="text-ink-soft">{vehicle.trim}</span></>)}
      <span aria-hidden="true">{t.common.arrow}</span>
      <span class="font-medium text-ink">{title}</span>
    </nav>
  </div>

  <!-- TITLE + STATUS -->
  <section class="container-site pb-6">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <h1 class="text-2xl font-bold text-ink sm:text-3xl">{title}</h1>
      <div class="flex items-center gap-2">
        {vehicle.is_demo && (
          <span class="rounded border border-surface-line bg-surface-alt px-2.5 py-1 text-xs font-semibold text-ink-muted">{t.vehicleCard.demoData}</span>
        )}
        <span class:list={[
          'rounded border px-2.5 py-1 text-xs font-semibold',
          isSold ? 'bg-red-50 text-red-700 border-red-200'
          : isReserved ? 'bg-amber-50 text-amber-700 border-amber-200'
          : 'bg-green-50 text-green-700 border-green-200',
        ]}>
          {statusLabel}
        </span>
      </div>
    </div>
    <p class="mt-1 text-sm text-ink-muted">{t.detail.vehicleId}: {vehicle.vehicle_id} · {t.detail.lastUpdated} {formatDate(vehicle.updated_at, locale)} · {t.detail.lastVerified} {lastVerifiedText}</p>
  </section>

  {isSold && (
    <div class="container-site pb-8">
      <div class="rounded-lg border border-red-200 bg-red-50 p-4">
        <p class="text-base font-semibold text-red-800">{t.detail.soldNoticeTitle}</p>
        <p class="mt-1 text-sm text-red-700">{t.detail.soldNoticeText}</p>
      </div>
    </div>
  )}

  <!-- GALLERY + SUMMARY -->
  <section class="container-site grid gap-8 lg:grid-cols-[1.4fr_1fr]">
    <!-- GALLERY -->
    <div>
      <div class="card overflow-hidden">
        <img
          src={vehicle.images[0]}
          alt={`${title} — ${t.vehicleCard.demoImageAlt}`}
          width="1200"
          height="800"
          fetchpriority="high"
          decoding="async"
          class="w-full object-cover"
        />
      </div>
      {vehicle.is_demo && (
        <p class="mt-2 text-xs text-ink-muted">
          {t.detail.demoImageNote}
        </p>
      )}
    </div>

    <!-- SUMMARY: PRICE / AVAILABILITY / LOCATION / QUICK SPECS -->
    <aside class="card h-fit p-5">
      <h2 class="sr-only">{t.detail.vehicleSummary}</h2>

      <div class="border-b border-surface-line pb-4">
        <p class="text-sm text-ink-muted">{t.detail.askingPrice}</p>
        <p class="mt-1 text-2xl font-bold text-ink">{formatPrice(vehicle.price, locale)}</p>
        {vehicle.original_price && (
          <p class="mt-1 text-xs text-ink-muted">{t.detail.originalListing}: {formatPrice(vehicle.original_price, locale)}</p>
        )}
        {vehicle.is_demo && <p class="mt-1 text-xs text-ink-muted">{t.detail.demoPrice}</p>}
        <p class="mt-2 text-xs text-ink-muted">{t.detail.priceNote}</p>
      </div>

      <dl class="grid grid-cols-2 gap-x-4 gap-y-3 pt-4 text-sm">
        <div><dt class="text-ink-muted">{t.detail.status}</dt><dd class="font-medium text-ink">{statusLabel}</dd></div>
        <div><dt class="text-ink-muted">{t.detail.location}</dt><dd class="font-medium text-ink">{location}</dd></div>
        <div><dt class="text-ink-muted">{t.detail.priceType}</dt><dd class="font-medium text-ink">{t.detail.priceTypeAsking}</dd></div>
        <div><dt class="text-ink-muted">{t.detail.registrationDate}</dt><dd class="font-medium text-ink">{vehicle.registration_date ?? t.detail.notCurrentlyAvailable}</dd></div>
        <div><dt class="text-ink-muted">{t.detail.year}</dt><dd class="font-medium text-ink">{vehicle.year}</dd></div>
        <div><dt class="text-ink-muted">{t.detail.mileage}</dt><dd class="font-medium text-ink">{formatMileage(vehicle.mileage_km, locale, t.units.km)}</dd></div>
        <div><dt class="text-ink-muted">{t.detail.fuel}</dt><dd class="font-medium text-ink">{fuel}</dd></div>
        <div><dt class="text-ink-muted">{t.detail.transmission}</dt><dd class="font-medium text-ink">{trans}</dd></div>
        <div><dt class="text-ink-muted">{t.detail.drive}</dt><dd class="font-medium text-ink">{drive}</dd></div>
        <div><dt class="text-ink-muted">{t.detail.bodyType}</dt><dd class="font-medium text-ink">{bodyTypeName(vehicle.body_type, locale, d.bodyType?.name ?? vehicle.body_type)}</dd></div>
        <div><dt class="text-ink-muted">{t.detail.color}</dt><dd class="font-medium text-ink">{color}</dd></div>
      </dl>

      <div class="mt-5 grid gap-2">
        {!isSold ? (
          <a href="#request-vehicle" class="btn-primary w-full">{t.detail.requestQuote}</a>
        ) : (
          <a href={localizedUrl('/contact/', locale)} class="btn-primary w-full">{t.detail.requestSimilar}</a>
        )}
        <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="btn-secondary w-full">{t.detail.whatsapp}</a>
        {!isSold && (
          <a href={localizedUrl('/contact/', locale)} class="btn-ghost w-full text-sm">{t.detail.requestSimilar}</a>
        )}
      </div>
    </aside>
  </section>

  <!-- DESCRIPTION -->
  <section class="container-site mt-10">
    <h2 class="text-xl font-bold text-ink">{t.detail.description}</h2>
    <p class="prose-vehicle mt-3 max-w-3xl">{desc}</p>
  </section>

  <!-- CONDITION -->
  <section class="container-site mt-10">
    <h2 class="text-xl font-bold text-ink">{t.detail.condition}</h2>
    <div class="mt-4 grid gap-px overflow-hidden rounded-lg border border-surface-line bg-surface-line sm:grid-cols-2 lg:grid-cols-4">
      {Object.entries(vehicle.condition).map(([k, v]) => (
        <div class="bg-white p-4">
          <dt class="text-sm text-ink-muted">{conditionLabelMap[k] ?? k}</dt>
          <dd class="mt-0.5 text-sm font-medium text-ink">{v == null ? t.confidence.notAvailable : v}</dd>
        </div>
      ))}
    </div>
  </section>

  <!-- VEHICLE HISTORY -->
  <section class="container-site mt-10">
    <h2 class="text-xl font-bold text-ink">{t.detail.history}</h2>
    <div class="mt-4 grid gap-px overflow-hidden rounded-lg border border-surface-line bg-surface-line sm:grid-cols-2 lg:grid-cols-4">
      <div class="bg-white p-4">
        <dt class="text-sm text-ink-muted">{t.detail.accidentHistory}</dt>
        <dd class="mt-0.5 text-sm font-medium text-ink">{accidentValue ?? t.detail.notCurrentlyAvailable}</dd>
      </div>
      <div class="bg-white p-4">
        <dt class="text-sm text-ink-muted">{t.detail.maintenanceHistory}</dt>
        <dd class="mt-0.5 text-sm font-medium text-ink">{maintenanceValue ?? t.detail.notCurrentlyAvailable}</dd>
      </div>
      <div class="bg-white p-4">
        <dt class="text-sm text-ink-muted">{t.detail.vehicleHistoryStatus}</dt>
        <dd class="mt-0.5 text-sm font-medium text-ink">{historyStatusValue}</dd>
      </div>
      <div class="bg-white p-4">
        <dt class="text-sm text-ink-muted">{t.detail.vinStatus}</dt>
        <dd class="mt-0.5 text-sm font-medium text-ink">{vinStatusValue}</dd>
      </div>
    </div>
  </section>

  <!-- INSPECTION -->
  <section class="container-site mt-10">
    <h2 class="text-xl font-bold text-ink">{t.detail.inspectionHeading}</h2>
    <div class="card mt-4 p-5">
      <dl class="text-sm">
        <div class="flex items-start justify-between gap-4">
          <dt class="text-ink-muted">{t.detail.inspectionStatus}</dt>
          <dd class="font-medium text-ink">{inspectionValue ?? t.confidence.notAvailable}</dd>
        </div>
      </dl>
      <p class="mt-3 text-sm text-ink-soft">{t.detail.inspectionNote}</p>
    </div>
  </section>

  <!-- BATTERY INFORMATION (EV / PHEV) -->
  {isBatteryVehicle && (
    <section class="container-site mt-10">
      <h2 class="text-xl font-bold text-ink">{t.detail.batteryHeading}</h2>
      <div class="mt-4 grid gap-px overflow-hidden rounded-lg border border-surface-line bg-surface-line sm:grid-cols-2 lg:grid-cols-3">
        <div class="bg-white p-4">
          <dt class="text-sm text-ink-muted">{t.detail.batteryCapacity}</dt>
          <dd class="mt-0.5 text-sm font-medium text-ink">{batteryCapacityValue ?? t.confidence.notAvailable}</dd>
        </div>
        <div class="bg-white p-4">
          <dt class="text-sm text-ink-muted">{t.detail.batteryHealth}</dt>
          <dd class="mt-0.5 text-sm font-medium text-ink">{batteryHealthValue ?? t.confidence.notAvailable}</dd>
        </div>
        <div class="bg-white p-4">
          <dt class="text-sm text-ink-muted">{t.detail.batteryStatusLabel}</dt>
          <dd class="mt-0.5 text-sm font-medium text-ink">{batteryStatusValue ?? t.detail.notCurrentlyAvailable}</dd>
        </div>
      </div>
      <p class="mt-3 text-sm text-ink-soft">{t.detail.batteryNote}</p>
    </section>
  )}

  <!-- DOCUMENTS -->
  <section class="container-site mt-10">
    <h2 class="text-xl font-bold text-ink">{t.detail.documentsHeading}</h2>
    <div class="card mt-4 p-5">
      {documentsValue && documentsValue.length > 0 ? (
        <ul class="list-disc space-y-1 ps-5 text-sm text-ink-soft">
          {documentsValue.map((doc) => <li>{doc}</li>)}
        </ul>
      ) : (
        <p class="text-sm text-ink-soft">{t.confidence.notAvailable}.</p>
      )}
      <p class="mt-3 text-sm text-ink-soft">{t.detail.documentsNote}</p>
    </div>
  </section>

  <!-- EXPORT INFORMATION (when real data exists) -->
  {vehicle.export && (
    <section class="container-site mt-10">
      <h2 class="text-xl font-bold text-ink">{t.detail.exportInfo}</h2>
      <div class="mt-4 grid gap-px overflow-hidden rounded-lg border border-surface-line bg-surface-line sm:grid-cols-2">
        {Object.entries(vehicle.export).map(([k, v]) => (
          <div class="bg-white p-4">
            <dt class="text-sm text-ink-muted">{exportLabelMap[k] ?? k}</dt>
            <dd class="mt-0.5 text-sm font-medium text-ink">{v}</dd>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- SHIPPING INFORMATION -->
  <section class="container-site mt-10">
    <h2 class="text-xl font-bold text-ink">{t.detail.shippingHeading}</h2>
    <div class="card mt-4 p-5">
      <p class="text-sm text-ink-soft">{t.detail.shippingNote}</p>
    </div>
  </section>

  <!-- DESTINATION CONSIDERATIONS -->
  <section class="container-site mt-10">
    <h2 class="text-xl font-bold text-ink">{t.detail.destinationHeading}</h2>
    <div class="card mt-4 p-5">
      <p class="text-sm text-ink-soft">{t.detail.destinationNote}</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href={localizedUrl('/markets/', locale)} class="btn-secondary !px-3 text-sm">{t.nav.markets} {t.common.arrow}</a>
        <a href={SITE.subdomains.market} target="_blank" rel="noopener noreferrer" class="btn-secondary !px-3 text-sm">{t.nav.marketInformation} {t.common.arrow}</a>
        <a href={toolUrl('landed-cost-calculator')} target="_blank" rel="noopener noreferrer" class="btn-secondary !px-3 text-sm">{t.tools.landedCost} {t.common.arrow}</a>
      </div>
    </div>
  </section>

  <!-- MODEL SPECIFICATIONS (model-level → data site) -->
  <section class="container-site mt-10">
    <h2 class="text-xl font-bold text-ink">{t.detail.keySpecs}</h2>
    <p class="mt-1 text-sm text-ink-muted">{t.detail.modelSpecsNote}</p>
    {modelDataUrl && (
      <p class="mt-2 text-sm">
        <a href={modelDataUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-700 hover:underline">
          {t.detail.modelSpecsLink} → data.chinausedautohub.com {t.common.arrow}
        </a>
      </p>
    )}
    <div class="mt-4 grid gap-px overflow-hidden rounded-lg border border-surface-line bg-surface-line sm:grid-cols-2 lg:grid-cols-3">
      {vehicle.specs.map((s) => (
        <div class="bg-white p-4">
          <dt class="text-sm text-ink-muted">{specLabel(s.label)}</dt>
          <dd class="mt-0.5 text-sm font-medium text-ink">{s.value}</dd>
        </div>
      ))}
    </div>
  </section>

  <!-- WHAT'S INCLUDED / EXCLUDED -->
  <section class="container-site mt-10">
    <div class="grid gap-5 sm:grid-cols-2">
      <div class="card p-5">
        <h2 class="text-lg font-bold text-ink">{t.detail.includedHeading}</h2>
        <p class="mt-2 text-sm text-ink-soft">{t.detail.includedText}</p>
      </div>
      <div class="card p-5">
        <h2 class="text-lg font-bold text-ink">{t.detail.excludedHeading}</h2>
        <p class="mt-2 text-sm text-ink-soft">{t.detail.excludedText}</p>
      </div>
    </div>
  </section>

  <!-- VEHICLE INFORMATION & VERIFICATION -->
  <section class="container-site mt-10">
    <h2 class="text-xl font-bold text-ink">{t.confidence.heading}</h2>
    <p class="mt-1 text-sm text-ink-muted">{t.confidence.intro}</p>

    <div class="mt-4 grid gap-px overflow-hidden rounded-lg border border-surface-line bg-surface-line sm:grid-cols-2 lg:grid-cols-4">
      <div class="bg-white p-4">
        <dt class="text-sm text-ink-muted">{t.confidence.source}</dt>
        <dd class="mt-0.5 text-sm font-medium text-ink">{sourceLabel}</dd>
      </div>
      <div class="bg-white p-4">
        <dt class="text-sm text-ink-muted">{t.confidence.lastChecked}</dt>
        <dd class="mt-0.5 text-sm font-medium text-ink">{lastVerifiedText}</dd>
      </div>
      <div class="bg-white p-4">
        <dt class="text-sm text-ink-muted">{t.confidence.lastUpdated}</dt>
        <dd class="mt-0.5 text-sm font-medium text-ink">{formatDate(vehicle.updated_at, locale)}</dd>
      </div>
      <div class="bg-white p-4">
        <dt class="text-sm text-ink-muted">{t.confidence.dataAvailability}</dt>
        <dd class="mt-0.5 text-sm font-medium text-ink">{dataAvailabilityText}</dd>
      </div>
    </div>

    <div class="mt-4 overflow-hidden rounded-lg border border-surface-line">
      <table class="w-full text-sm">
        <thead class="bg-surface-alt text-ink-soft">
          <tr>
            <th class="px-4 py-2.5 text-start font-semibold">{t.confidence.field}</th>
            <th class="px-4 py-2.5 text-start font-semibold">{t.confidence.verificationLevel}</th>
          </tr>
        </thead>
        <tbody>
          {verificationRows.map((r) => (
            <tr class="border-t border-surface-line">
              <td class="px-4 py-2.5 text-ink-soft">{r.label}</td>
              <td class="px-4 py-2.5 font-medium text-ink">{r.level}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- ABOUT THIS MODEL -->
  <section class="container-site mt-10">
    <div class="card p-5">
      <h2 class="text-lg font-bold text-ink">{aboutModelHeading}</h2>
      <p class="mt-2 text-sm text-ink-soft max-w-3xl">{modelDescription(vehicle.brand, vehicle.model, locale, d.model?.shortDescription ?? t.detail.modelInfo)}</p>
      <div class="mt-3">
        {modelDataUrl && (
          <a href={modelDataUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-brand-700 hover:underline">
            {viewModelSpecsText} {t.common.arrow}
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- RELATED VEHICLE DATA -->
  <section class="container-site mt-10">
    <h2 class="text-xl font-bold text-ink">{t.detail.relatedData}</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {modelDataUrl && (
        <a href={modelDataUrl} target="_blank" rel="noopener noreferrer" class="card p-4 hover:border-brand-300">
          <span class="block text-sm font-semibold text-ink">{modelName}</span>
          <span class="mt-1 block text-xs text-ink-muted">{t.common.viewSpecifications}</span>
        </a>
      )}
      <a href={dataBrandUrl({ slug: vehicle.brand })} target="_blank" rel="noopener noreferrer" class="card p-4 hover:border-brand-300">
        <span class="block text-sm font-semibold text-ink">{brandName}</span>
        <span class="mt-1 block text-xs text-ink-muted">{t.common.brandData}</span>
      </a>
    </div>
  </section>

  <!-- RELATED GUIDES -->
  <section class="container-site mt-10">
    <h2 class="text-xl font-bold text-ink">{t.detail.relatedGuides}</h2>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {relatedGuides.map((g) => (
        <a href={localizedUrl(guideUrl(g.slug), locale)} class="card p-4 hover:border-brand-300">
          <span class="block text-sm font-semibold text-ink">{pick(g.title, locale)}</span>
          <span class="mt-1 block text-xs text-ink-muted">{t.nav.guides}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- SIMILAR -->
  {similar.length > 0 && (
    <section class="container-site mt-12">
      <h2 class="text-xl font-bold text-ink">{t.detail.similar}</h2>
      <div class="mt-4 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {similar.map((v) => <VehicleCard vehicle={v} />)}
      </div>
    </section>
  )}

  <!-- FAQ -->
  {faqs.length > 0 && (
    <section class="container-site mt-12 max-w-3xl">
      <h2 class="text-xl font-bold text-ink">{t.common.faq}</h2>
      <div class="mt-4 space-y-3">
        {faqs.map((f) => (
          <details class="card p-4">
            <summary class="cursor-pointer text-sm font-semibold text-ink">{f.question}</summary>
            <p class="mt-2 text-sm text-ink-soft">{f.answer}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  <!-- REQUEST A VEHICLE -->
  <section class="container-site mt-12" id="request-vehicle">
    <h2 class="text-xl font-bold text-ink">{t.detail.requestVehicle}</h2>
    <div class="mt-4">
      <LeadForm variant="quote" vehicle={vehicle} />
    </div>
  </section>
</BaseLayout>
